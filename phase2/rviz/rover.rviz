Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Tree Height: 720
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 34; 38; 40
    Fixed Frame: odom
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 24
      Color: 66; 74; 76
      Alpha: 0.5
      Reference Frame: odom

    # ── the room, from nvblox ────────────────────────────────────────────
    # nvblox publishes VOLATILE. With Transient Local here RViz receives
    # nothing and shows an empty screen while the map is running perfectly.
    - Class: rviz_default_plugins/Map
      Name: ROOM (nvblox)
      Enabled: true
      Topic:
        Value: /nvblox_node/static_occupancy_grid
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 1
      Draw Behind: true
      Update Topic:
        Value: /nvblox_node/static_occupancy_grid_updates

    # ── what nav2 plans on ───────────────────────────────────────────────
    # nav2's costmaps publish TRANSIENT_LOCAL -- the opposite of nvblox.
    - Class: rviz_default_plugins/Map
      Name: Costmap - global
      Enabled: false
      Topic:
        Value: /global_costmap/costmap
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.6
    - Class: rviz_default_plugins/Map
      Name: Costmap - local
      Enabled: false
      Topic:
        Value: /local_costmap/costmap
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.6

    # ── where it has been ────────────────────────────────────────────────
    - Class: rviz_default_plugins/Path
      Name: Track driven
      Enabled: true
      Topic:
        Value: /fusion/path
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color: 85; 200; 140
      Line Style: Lines
      Alpha: 1

    # ── where nav2 wants to go ───────────────────────────────────────────
    - Class: rviz_default_plugins/Path
      Name: nav2 plan
      Enabled: true
      Topic:
        Value: /plan
        Depth: 1
        Reliability Policy: Reliable
      Color: 255; 190; 60
      Line Style: Lines
      Alpha: 1

    # ── the rover ────────────────────────────────────────────────────────
    - Class: rviz_default_plugins/Odometry
      Name: Fused pose
      Enabled: true
      Topic:
        Value: /odom
        Depth: 20
        Reliability Policy: Reliable
      Keep: 1
      Shape:
        Value: Arrow
        Color: 72; 200; 210
        Alpha: 1
        Shaft Length: 0.25
        Shaft Radius: 0.04
        Head Length: 0.13
        Head Radius: 0.09
      Covariance:
        Value: true
        Position:
          Alpha: 0.3
          Color: 72; 200; 210
        Orientation:
          Value: false
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Topic:
        Value: /global_costmap/published_footprint
        Depth: 1
        Reliability Policy: Reliable
      Color: 72; 200; 210
      Alpha: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.4

    # ── diagnostics, off unless you want them ────────────────────────────
    # Turn this on beside the fused pose and drive somewhere with poor
    # texture: the red arrow teleports across the room, the teal one does not.
    - Class: rviz_default_plugins/Odometry
      Name: Raw cuVSLAM (watch it teleport)
      Enabled: false
      Topic:
        Value: /vo/odom
        Depth: 20
        Reliability Policy: Best Effort
      Keep: 1
      Shape:
        Value: Arrow
        Color: 220; 110; 95
        Alpha: 0.7
        Shaft Length: 0.2
        Shaft Radius: 0.03
        Head Length: 0.1
        Head Radius: 0.07
    - Class: rviz_default_plugins/Image
      Name: IR left
      Enabled: false
      Topic:
        Value: /camera/camera0/infra1/image_rect_raw
        Reliability Policy: Best Effort

  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 9
      Pitch: 1.2
      Yaw: 3.14
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Height: 950
  Width: 1500
  Displays:
    collapsed: false
