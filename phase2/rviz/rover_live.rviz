# LangRobo rover live view.
#
# Fixed Frame is `map`, and that is a DELIBERATE change from `odom` (2026-09-22).
#
# `map` is published by slam_toolbox (`./rover slam`) since the lidar went in.
# Which frame is fixed decides what the picture means, and only one of the two
# answers the question "where is the rover in the room":
#
#   Fixed Frame = odom   the ROOM slides under a stationary rover every time
#                        the correction updates. The map is the thing moving.
#   Fixed Frame = map    the room holds still and the ROVER moves through it,
#                        jumping slightly whenever the lidar corrects it.
#
# The second is what you want to look at, and it is what makes the two track
# lines legible (see them below). The cost is that `./rover slam` MUST be up:
# with no map frame this window is blank and the error reads like a data fault.
# `./rover view` checks for map -> odom and says so rather than letting you
# hunt. If you need to look at the stack with slam deliberately down, set
# Fixed Frame back to `odom` in the Displays panel -- nothing else changes.
#
# Load it with -d. `rviz2 rover_live.rviz` silently ignores the file and starts
# with defaults. It must be `rviz2 -d rover_live.rviz`.
Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Rover1
        - /Track1
        - /Map1
      Splitter Ratio: 0.5
    Tree Height: 640
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Alpha: 0.12
      Cell Size: 0.5
      Class: rviz_default_plugins/Grid
      Color: 130; 130; 150
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid 50cm
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true

    # ── the rover from its URDF (description/params.yaml, measured) ─────
    # robot_state_publisher serves /robot_description latched, so a late RViz
    # still gets it. Primitives only (boxes/cylinders), so nothing needs to be
    # installed on the laptop for it to draw.
    - Alpha: 0.9
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      TF Prefix: ""
      Visual Enabled: true
      Value: true

    # ── the footprint nav2 keeps clear, as nav2 itself publishes it ─────
    # From description/params.yaml via nav2.yaml; the outline to read for
    # "does it fit through there". (Replaced rover_marker's copy of it.)
    - Alpha: 1
      Class: rviz_default_plugins/Polygon
      Color: 255; 122; 23
      Enabled: true
      Name: Footprint
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/published_footprint
      Value: true

    # ── the lidar ring: what the C1 sees, in the laser frame ────────────
    # Points, not squares — 720 of them at 10 Hz. Best-effort QoS to match
    # the driver; Reliable would show nothing.
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/LaserScan
      Color: 255; 85; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Lidar ring (live)
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 4
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Use Fixed Frame: true
      Use rainbow: false
      Value: true

    # ── THE ROOM: the lidar's map (slam_toolbox), and the frame we live in ──
    # Drawn under everything else, and opaque -- this is the primary map now,
    # not a translucent overlay on top of nvblox's. 5 cm cells. Black is a wall
    # the lidar has actually seen, light grey is confirmed-open floor, and mid
    # grey is unknown: the difference between "there is nothing there" and
    # "nothing has looked there yet" is most of what you are reading on a map.
    - Alpha: 1
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Room (lidar)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Update Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map_updates
      Use Timestamp: false
      Value: true

    # ── where it has been: fusion2's track (/fusion/path, odom) ─────────
    # Since 2026-09-26 odom is LiDAR-anchored (fusion2), so this track no
    # longer drifts away from the room the way the old dead-reckoned one did,
    # and the separate "lidar-corrected" line it was compared against is gone.
    # If the track and the map disagree now, something is wrong: look at
    # ./rover status (the pose row) before trusting either.

    - Alpha: 0.85
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 70; 70
      Enabled: true
      Head Diameter: 0
      Head Length: 0
      Length: 0.3
      Line Style: Billboards
      Line Width: 0.028
      Name: Track - fusion2
      Offset:
        X: 0
        Y: 0
        Z: 0.01
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.02
      Shaft Length: 0.05
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fusion/path
      Value: true

    # ── nvblox's own grid. OFF by default since the lidar arrived ───────
    # It is not redundant -- it is built from depth, so it sees what the lidar
    # plane cannot: things below 21 cm and above it. But two occupancy grids
    # stacked in the same place is unreadable, and the lidar's is the one the
    # pose is corrected against. Turn this on when the question is specifically
    # "is there an obstacle the lidar cannot see".
    - Alpha: 0.85
      Binary representation: false
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: true
      Enabled: false
      Name: Room (nvblox depth)
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /nvblox_node/static_occupancy_grid
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /nvblox_node/static_occupancy_grid_updates
      Use Timestamp: false
      Value: false

    # ── what nav2 plans on, NEAR the rover (4 x 4 m local costmap). ─────
    # Pink = an obstacle, cyan = the rover's centre may not go there, blue ->
    # red = allowed but close to something. A passable gap shows a coloured
    # strip down its middle between the cyan bands (OPERATIONS.md, nav2).
    - Alpha: 0.45
      Binary representation: false
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: nav2 costmap (near)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
      Use Timestamp: false
      Value: true

    # The WHOLE room's costmap. OFF by default: every obstacle wears a 45 cm
    # cost halo (inflation_radius), and over a room it is blobs that hide the
    # map (the owner's screenshots, 2026-09-26).
    - Alpha: 0.35
      Binary representation: false
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: false
      Name: nav2 costmap (whole room)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
      Use Timestamp: false
      Value: false

    # ── obstacles at the rover's height, 1 cm: what goal_exec and ./rover
    # pass decide on (depth camera, remembered in odom). Coloured by height:
    # the low end (2-5 cm: feet, remotes, cables) is what nothing else sees.
    - Alpha: 1
      Autocompute Intensity Bounds: false
      Axis: Z
      Channel Name: z
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 0.27
      Min Color: 0; 0; 0
      Min Intensity: 0.0
      Name: Obstacles at rover height (1 cm)
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 3
      Size (m): 0.012
      Style: Boxes
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_exec/obstacles
      Use Fixed Frame: true
      Use rainbow: true
      Value: true

    # ── the tight-gap pass: the strip found, the rover + margin swept along
    # the line, the line, and the width. Green fits, red too tight. ───────
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Gap pass
      Namespaces:
        {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /gap_pass/markers
      Value: true

    # ── the planned route, when nav2 is running ─────────────────────────
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 220; 0
      Enabled: true
      Head Diameter: 0
      Head Length: 0
      Length: 0.3
      Line Style: Billboards
      Line Width: 0.05
      Name: nav2 plan
      Offset:
        X: 0
        Y: 0
        Z: 0.02
      Pose Style: None
      Radius: 0.03
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan
      Value: true

    # ── frames. OFF by default: 8 frames of clutter over a small map. ───
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.4
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: false

  Enabled: true
  Global Options:
    Background Color: 26; 26; 32
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /reach/goal
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Top down
      Near Clip Distance: 0.01
      Scale: 90
      # <Fixed Frame>, not base_link. With base_link the camera rides the rover,
      # so the rover is pinned to the centre of the screen and the map slides
      # past it -- you can never see where it is IN the room, which is the one
      # thing this view is for. The saved 'Orbit' view keeps base_link, so
      # switching views gives you the follow-cam when you want it.
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
      X: 0
      Y: 0
    Saved:
      - Class: rviz_default_plugins/Orbit
        Distance: 6
        Enable Stereo Rendering:
          Stereo Eye Separation: 0.06
          Stereo Focal Distance: 1
          Swap Stereo Eyes: false
          Value: false
        Focal Point:
          X: 0
          Y: 0
          Z: 0
        Focal Shape Fixed Size: true
        Focal Shape Size: 0.05
        Invert Z Axis: false
        Name: Orbit
        Near Clip Distance: 0.01
        Pitch: 0.9
        Target Frame: base_link
        Value: Orbit (rviz_default_plugins)
        Yaw: 3.1
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1500
  X: 60
  Y: 40
