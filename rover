#!/usr/bin/env bash
# rover — Phase 1 bring-up, one layer at a time.
#
#   ./rover camera     the D555, and nothing else
#   ./rover pose       + visual odometry and the gyro
#   ./rover wheels     check the ESP32 link (diagnose only; cannot fix from here)
#   ./rover compare    the side-by-side readout — the Phase 1 instrument
#   ./rover values     every sensor's current reading, in one place
#   ./rover status     what is alive right now
#   ./rover fused      the fused pose -> /odom + TF, what nav2 consumes
#   ./rover map        nvblox — build the room as it drives (Phase 2)
#   ./rover nav        nav2 — click a goal, it plans and drives there (Phase 3)
#   ./rover rviz       view it on the Jetson's own screen (costs GPU)
#   ./rover view       RViz on the laptop — finds it on DHCP, checks it renders
#   ./rover logs <n>   tail a layer's log (camera|vo|gyro|fused)
#   ./rover stop       tear the container down
#
# WHY LAYERS. Four machines and a camera that can be knocked offline by being
# poked at. If everything starts at once, a failure is a wall of log with no
# owner. Each layer here starts alone and prints its own PASS/FAIL, so the
# failure names itself.
set -eo pipefail

IMAGE=${IMAGE:-orin-nav:1.1}
NAME=${NAME:-rover}
LAPTOP_USER=${LAPTOP_USER:-rakhi24}   # LAPTOP_IP is DISCOVERED, not fixed: DHCP moves it
SRC=/opt/rover
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOSTSRC="$REPO/phase1"
SRC2=/opt/rover2
SRC3=/opt/rover3
CAM_NS=/camera/camera0

# The cuvslam wheel ships its own libcuvslam.so and CUDA-12 userspace libs, and
# they must come BEFORE Isaac ROS's own build in /opt/ros/jazzy — that one is
# compiled for Thor and will not run on this Orin.
CU=/usr/local/lib/python3.12/dist-packages
CU12="$CU/cuvslam:$CU/nvidia/cuda_runtime/lib:$CU/nvidia/cublas/lib:$CU/nvidia/cusolver/lib:$CU/nvidia/cusparse/lib:$CU/nvidia/nvjitlink/lib:$CU/nvidia/nvtx/lib"

# A stale ROS_DISCOVERY_SERVER makes nodes silently invisible to each other,
# which looks exactly like a crashed node. Clear it on every command.
ENVSET='unset ROS_DISCOVERY_SERVER FASTRTPS_DEFAULT_PROFILES_FILE; export ROS_DOMAIN_ID=0; source /opt/ros/jazzy/setup.bash;'

dexec(){ docker exec -d "$NAME" bash -lc "$ENVSET $1"; }
rexec(){ docker exec    "$NAME" bash -lc "$ENVSET $1"; }
running(){ [ "$(docker inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null)" = "true" ]; }
die(){ echo "  ✗ $*" >&2; exit 1; }
kill_match(){ docker exec "$NAME" bash -lc "for p in \$(pgrep -f '$1'); do kill -9 \$p 2>/dev/null; done; true" >/dev/null 2>&1 || true; }

need_container(){ running || die "no container. Run: ./rover camera"; }

# Measure a topic's rate. Rates are the honest signal: every failure this rig
# has had was a rate collapsing, not a topic disappearing.
rate_of(){
  rexec "timeout 12 ros2 topic hz $1 --window 20 2>/dev/null | awk '/average rate/{r=\$3} END{print r+0}'" 2>/dev/null || echo 0
}

assert_rate(){ # topic  min_hz  label
  local hz; hz=$(rate_of "$1")
  local ok; ok=$(awk -v a="$hz" -v b="$2" 'BEGIN{print (a>=b)?1:0}')
  printf '      %-22s %7.1f Hz   (want >= %s)   %s\n' "$3" "$hz" "$2" \
    "$([ "$ok" = 1 ] && echo OK || echo FAIL)"
  [ "$ok" = 1 ]
}

start_container(){
  docker rm -f "$NAME" >/dev/null 2>&1 || true
  mkdir -p "$REPO/logs"
  # phase1/ is mounted READ-ONLY: edit a node on the host, restart the layer,
  # no rebuild. The image has no build recipe, so it must never be modified.
  docker run -d --name "$NAME" --entrypoint /bin/bash \
    --runtime=nvidia --network=host --privileged \
    -e NVIDIA_VISIBLE_DEVICES=all -e NVIDIA_DRIVER_CAPABILITIES=all -e NVIDIA_DISABLE_REQUIRE=1 \
    -e ROS_DOMAIN_ID=0 \
    -v "$HOSTSRC":$SRC:ro \
    -v "$REPO/phase2":$SRC2:ro \
    -v "$REPO/phase3":$SRC3:ro \
    -v "$REPO/logs":/logs \
    "$IMAGE" -c 'sleep infinity' >/dev/null
  sleep 2
}

# The D555 answers ping while completely dead — it is a network device speaking
# DDS, not a USB camera. The only real check is a live publisher on infra1.
cam_ready(){
  rexec "n=\$(ros2 topic info $CAM_NS/infra1/image_rect_raw 2>/dev/null | awk '/Publisher count/{print \$3}'); [ \"\${n:-0}\" -ge 1 ]" >/dev/null 2>&1
}

case "${1:-}" in

# ── camera ──────────────────────────────────────────────────────────────────
camera)
  start_container
  echo "[camera] D555 — stereo IR + depth + motion"
  echo "         emitter OFF and sync OFF; both are load-bearing, see phase1/README.md"
  dexec 'printf "{\"context\":{\"dds\":{\"enabled\":true,\"domain\":0}}}" > ~/.realsense-config.json;
         export LD_LIBRARY_PATH=/root/librealsense/install/lib:$LD_LIBRARY_PATH;
         exec ros2 launch realsense2_camera rs_launch.py camera_name:=camera0 \
            enable_infra1:=true enable_infra2:=true depth_module.infra_profile:=896x504x30 \
            depth_module.emitter_enabled:=false depth_module.laser_power:=0.0 \
            enable_depth:=true enable_color:=false \
            enable_motion:=true enable_sync:=false > /tmp/camera.log 2>&1'
  t=0
  until cam_ready; do
    t=$((t+3)); [ "$t" -ge 40 ] && { echo "  ✗ D555 not streaming after 40 s."
      docker exec "$NAME" grep -q "No RealSense devices were found" /tmp/camera.log 2>/dev/null \
        && echo "    Its on-camera DDS server is offline. It still answers ping; that means nothing."
      echo "    Only a physical PoE power-cycle (unplug ~5 s) recovers this."
      echo "    Container left up so you can retry: ./rover camera"; exit 1; }
    sleep 3
  done
  echo "      D555 streaming — OK"

  # The emitter MUST be off, and a launch argument is not proof that it is.
  # `emitter_enabled:=0` looks like it works and does nothing: the parameter is
  # a Boolean and the string "0" does not parse as false, so the driver silently
  # keeps its default of ON. That cost a session — the projector is bolted to the
  # camera, so its dots move with the rig, the scene looks static, and cuVSLAM
  # under-read a 60 cm push as 1.1 cm. Set it at runtime and READ IT BACK.
  #
  # Retry it. Streaming coming up does NOT mean the camera's control channel is
  # ready: seen 2026-08-15, `ros2 param set` returned
  #   "timeout waiting for reply: {"id":"set-option","option-name":"Emitter Enabled"}"
  # on every attempt while infra1 was streaming perfectly at 30 Hz. The device
  # answers image traffic before it answers option traffic, so attaching too soon
  # after a power-cycle leaves the emitter stuck on with everything else looking
  # healthy. Give it up to ~30 s.
  em=""
  for a in 1 2 3 4 5 6; do
    rexec "ros2 param set /camera/camera0 depth_module.emitter_enabled false; \
           ros2 param set /camera/camera0 depth_module.laser_power 0.0" >/dev/null 2>&1 || true
    em=$(rexec "ros2 param get /camera/camera0 depth_module.emitter_enabled" 2>/dev/null | tail -1)
    case "$em" in *False*) break ;; esac
    [ "$a" -lt 6 ] && { echo "      emitter still on, control channel not ready — retry $a/5"; sleep 5; }
  done
  case "$em" in
    *False*) echo "      IR emitter OFF — verified" ;;
    *)       echo "  ✗ IR EMITTER IS STILL ON ($em)."
             echo "    Visual odometry will under-read badly. Do not trust any pose."
             echo "    The camera is half-alive: it streams but will not accept options."
             echo "    Power-cycle the D555, wait 30 s for it to finish booting, retry."
             exit 1 ;;
  esac
  echo
  echo "  GATE camera:"
  assert_rate "$CAM_NS/infra1/image_rect_raw" 15 "IR left"  || true
  assert_rate "$CAM_NS/depth/image_rect_raw"  10 "depth"    || true
  echo
  echo "  Next: ./rover pose"
  ;;

# ── pose ────────────────────────────────────────────────────────────────────
# SLAM (loop closure) is ON by default now that Phase 1 has its drift numbers.
# It publishes map -> odom; odom -> base_link stays continuous and owned by
# fusion_node, so a loop closure cannot look like the teleports the fusion
# rejects. Run with SLAM=false ./rover pose to measure raw drift again.
pose)
  need_container
  echo "  checking the camera is still healthy before building on it..."
  assert_rate "$CAM_NS/infra1/image_rect_raw" 15 "IR left" || die "camera unhealthy — fix that first"

  # base_link -> camera0_link must exist BEFORE the pose starts, or the first
  # poses land in a frame tree with a missing link.
  echo "[pose] static TF base_link -> camera0_link"
  kill_match "[s]tatic_transform_publisher"
  dexec "exec ros2 run tf2_ros static_transform_publisher --x 0.17 --y 0.0 --z 0.163 \
            --frame-id base_link --child-frame-id camera0_link > /tmp/statictf.log 2>&1"
  sleep 1

  echo "[pose] visual odometry  (stereo IR -> /vo/odom, TF odom -> base_link)"
  kill_match "[v]o_node.py"
  dexec "export LD_LIBRARY_PATH=$CU12:\$LD_LIBRARY_PATH; exec python3 $SRC/nodes/vo_node.py --ros-args -p publish_tf:=false -p slam:=\${SLAM:-true} > /tmp/vo.log 2>&1"

  echo "[pose] gyro  (D555 IMU, re-framed into base_link -> /gyro/base)"
  kill_match "[g]yro_node.py"
  dexec "exec python3 $SRC/nodes/gyro_node.py > /tmp/gyro.log 2>&1"
  sleep 10

  echo
  echo "  GATE pose — rate only. Alive is not the same as HONEST:"
  assert_rate /vo/odom   10 "visual odometry" || true
  assert_rate /gyro/base 50 "gyro"            || true
  echo
  echo "  Now prove it is honest, with a tape measure:"
  echo "      ./rover compare --expect 2.00     push 2.00 m straight"
  echo "      ./rover compare --return          out 2.00 m and back to the mark"
  echo "      ./rover compare --spin 360        rotate 360 deg by hand"
  ;;

# ── wheels ──────────────────────────────────────────────────────────────────
wheels)
  need_container
  echo "[wheels] ESP32 -> micro-ROS agent (Pi 5) -> /wheel_state"
  echo "         firmware publishes at 20 Hz whenever it is AGENT_CONNECTED,"
  echo "         with no motion gating — so a low rate never means 'it was parked'."
  echo
  assert_rate /wheel_state 15 "wheel_state" && { echo; echo "  Wheels are live."; exit 0; }
  echo
  echo "  ✗ Wheel odometry is not usable. Known state as of 2026-08-15:"
  echo "      /wheel_state arrives at a metronomic 1.000 Hz (sigma 3.4 ms over 55 samples)."
  echo "      Packet loss is ruled out by that regularity; the ESP32 is connected"
  echo "      in one stable micro-ROS session. But rover_firmware_v2.ino has NO"
  echo "      1 Hz publish path — telemetry is EXECUTE_EVERY_N_MS(50,...) = 20 Hz."
  echo "      => the flashed binary does not match the repo source."
  echo
  echo "    Neither the Jetson nor the Pi 5 has a flashing toolchain or USB serial,"
  echo "    so this needs a reflash from your own machine. OTA is compiled in;"
  echo "    the board is now at 192.168.1.3 (it moved off .12)."
  echo
  echo "    compare still runs without it — the wheels row just stays empty."
  ;;

# ── fused ───────────────────────────────────────────────────────────────────
fused)
  need_container
  echo "  checking the pose layer is up before building on it..."
  assert_rate /vo/odom 10 "visual odometry" || die "no pose — run ./rover pose first"
  kill_match 'fusion_node.py'
  kill_match 'rover_marker.py'
  echo "[fused] PoseFusion -> /odom, and TF odom -> base_link"
  echo "        vo_node runs with publish_tf:=false; only one thing may own a"
  echo "        transform, and the raw cuvslam pose is the one that teleports."
  dexec "python3 $SRC/nodes/fusion_node.py > /tmp/fused.log 2>&1"
  # The rover's body, on /rover/model. It belongs to this layer because it is
  # drawn in base_link and base_link is what this layer starts publishing. It
  # was never started by ANY layer until 2026-08-26, so RViz's "Rover" display
  # had been empty since it was written and `./rover status` showed a permanent
  # `--` on the view row. Nothing was broken; nothing had ever been run.
  dexec "python3 $SRC2/nodes/rover_marker.py > /tmp/marker.log 2>&1"
  sleep 4
  echo
  echo "  GATE fused:"
  assert_rate /odom 15 "fused odom" || true
  assert_rate /rover/model 0.5 "rover body" || true
  echo
  echo "  Health, live:  ./rover compare"
  echo "  Raw status:    ros2 topic echo /fusion/status"
  ;;

# ── map ─────────────────────────────────────────────────────────────────────
map)
  need_container
  echo "  checking the fused pose is up before building a map on it..."
  assert_rate /odom 15 "fused odom" || die "no fused pose — run ./rover fused first"
  kill_match 'nvblox_node'
  echo "[map] nvblox — depth + the FUSED pose -> TSDF mesh and a 2D floor slice"
  echo "      built on /odom, not raw cuvslam: nvblox writes depth wherever the"
  echo "      pose claims the robot is, so a teleport smears the map permanently."
  dexec "ros2 launch $SRC2/launch/nvblox.launch.py > /tmp/map.log 2>&1"
  # nvblox allocates GPU hash tables and warms up its integrators before it
  # publishes anything; checked too early it reads 0 Hz and looks broken.
  sleep 25
  echo
  echo "  GATE map:"
  # static_occupancy_grid, NOT static_map_slice: that name carries an
  # nvblox_msgs/DistanceMapSlice, while the nav_msgs/OccupancyGrid RViz and
  # nav2 want is this one.
  assert_rate /nvblox_node/static_occupancy_grid 1 "2D occupancy grid" || true
  assert_rate "/nvblox_node/back_projected_depth/camera0_depth_optical_frame" 5 "depth integrated" || true
  echo
  echo "  How much is mapped:"
  rexec "python3 /logs/map_stats.py" 2>/dev/null | sed -n "/grid/,/occupied/p" | sed "s/^/    /"
  echo
  echo "  Drive it and the map grows. In RViz: nvblox mesh, nvblox 2D slice."
  echo "  Log: ./rover logs map"
  ;;

# ── nav ─────────────────────────────────────────────────────────────────────
nav)
  need_container
  echo "  checking the pose and the map are up before planning on them..."
  assert_rate /odom 15 "fused odom" || die "no fused pose — run ./rover fused"
  assert_rate /nvblox_node/static_occupancy_grid 1 "map" || die "no map — run ./rover map"
  kill_match 'nav2_|lifecycle_manager|controller_server|planner_server|bt_navigator'
  echo "[nav] nav2 — plan a route on the nvblox map and drive it"
  echo "      frame is odom, not map: this navigates within one session."
  echo "      Spin recovery and rotate-to-heading are OFF — see TODO 14, this"
  echo "      rover cannot turn in place and nav2 would sit still waiting."
  dexec "ros2 launch $SRC3/launch/nav2.launch.py > /tmp/nav.log 2>&1"
  sleep 20
  echo
  echo "  GATE nav:"
  assert_rate /global_costmap/costmap 0.5 "global costmap" || true
  assert_rate /local_costmap/costmap 1 "local costmap" || true
  echo
  echo "  Now set a goal: in RViz use the '2D Goal Pose' tool, or"
  echo "    ros2 topic pub --once /goal_pose geometry_msgs/PoseStamped ..."
  echo "  Log: ./rover logs nav"
  ;;

# ── rviz ────────────────────────────────────────────────────────────────────
rviz)
  need_container
  echo "[rviz] on the Jetson's own display. Prefer ./rover view on the laptop —"
  echo "       rviz2 here competes with cuVSLAM for the GPU and the pose rate dips."
  xhost +local:docker >/dev/null 2>&1 || true
  docker exec -it -e DISPLAY=:0 "$NAME" bash -lc \
    "$ENVSET rviz2 -d $SRC2/rviz/rover_live.rviz"
  ;;

# ── the laptop view ─────────────────────────────────────────────────────────
view)
  # The laptop is on DHCP and MOVES: .10 on 2026-08-21, .17 on 2026-08-22. So
  # find it rather than hardcode it. It is the host that answers ssh AND has the
  # view script — the Jetson and the Pi 5 both answer ssh too.
  echo "[view] RViz on the laptop"
  ip="${LAPTOP_IP:-}"
  if [ -z "$ip" ]; then
    printf "  looking for the laptop"
    for i in $(seq 2 40); do
      cand="192.168.1.$i"
      [ "$cand" = "$(hostname -I | tr ' ' '\n' | grep '^192\.168\.1\.' | head -1)" ] && continue
      if timeout 1 bash -c "echo > /dev/tcp/$cand/22" 2>/dev/null; then
        if timeout 6 ssh -o BatchMode=yes -o ConnectTimeout=3 "$LAPTOP_USER@$cand" \
             'test -f ~/rover_live.sh' 2>/dev/null; then
          ip="$cand"; break
        fi
      fi
      printf "."
    done
    echo
  fi
  [ -n "$ip" ] || die "no laptop found. Is it on, and awake? Set LAPTOP_IP=x.x.x.x to skip the search."
  echo "  found at $ip"

  # Push the config every time. The laptop used to hold its own copy, which
  # drifted from the repo's and made "I fixed the RViz config" untrue on the
  # only machine that renders it. The repo is the single source; the laptop is
  # a display.
  scp -q -o BatchMode=yes "$(dirname "$0")/phase2/rviz/rover_live.rviz" \
      "$LAPTOP_USER@$ip:~/rover_live.rviz" 2>/dev/null \
    && echo "  config synced from the repo" \
    || echo "  ! could not sync the config — the laptop may be showing an old one"

  # A desktop session must exist. RViz over ssh with nobody logged in renders
  # into nothing and exits 0 — it looks exactly like a data fault, and it cost
  # an evening once. Xwayland's cmdline is the authoritative source for both the
  # display number and the auth cookie; on Wayland `loginctl -p Display` is EMPTY.
  xw=$(timeout 8 ssh -o BatchMode=yes "$LAPTOP_USER@$ip" 'pgrep -a Xwayland 2>/dev/null | head -1' 2>/dev/null)
  if [ -z "$xw" ]; then
    echo "  ✗ nobody is logged in at the laptop desktop."
    echo "    RViz cannot render into a login screen. Log in there, then re-run."
    exit 1
  fi
  disp=$(echo "$xw" | grep -oE ' :[0-9]+' | head -1 | tr -d ' ')
  auth=$(echo "$xw" | sed -nE 's/.* -auth ([^ ]+).*/\1/p')
  echo "  display ${disp:-:0}"

  # pgrep -x, never -f: -f matches our own ssh command line and always "succeeds".
  if timeout 8 ssh -o BatchMode=yes "$LAPTOP_USER@$ip" 'pgrep -x rviz2 >/dev/null' 2>/dev/null; then
    echo "  already running — look at the laptop screen"
  else
    timeout 25 ssh -o BatchMode=yes "$LAPTOP_USER@$ip" \
      "DISPLAY=${disp:-:0} XAUTHORITY=$auth XDG_RUNTIME_DIR=/run/user/\$(id -u) \
       setsid nohup bash ~/rover_live.sh >/tmp/rviz.log 2>&1 </dev/null & sleep 12" >/dev/null 2>&1
    if timeout 8 ssh -o BatchMode=yes "$LAPTOP_USER@$ip" 'pgrep -x rviz2 >/dev/null' 2>/dev/null; then
      echo "  started"
    else
      echo "  ✗ rviz2 did not stay up. Its error is ON THE LAPTOP:"
      timeout 8 ssh -o BatchMode=yes "$LAPTOP_USER@$ip" 'tail -8 /tmp/rviz.log' 2>/dev/null | sed 's/^/      /'
      exit 1
    fi
  fi

  # Running is not the same as receiving. A blank RViz still shows as running.
  echo "  subscriptions (0 means it is connected to nothing):"
  for t in /rover/model /fusion/path /nvblox_node/static_occupancy_grid; do
    c=$(timeout 8 ssh -o BatchMode=yes "$LAPTOP_USER@$ip" \
        "source /opt/ros/jazzy/setup.bash; export ROS_DOMAIN_ID=0; unset ROS_DISCOVERY_SERVER; \
         timeout 6 ros2 topic info $t 2>/dev/null | grep -oP 'Subscription count: \K[0-9]+'" 2>/dev/null)
    printf "      %-42s %s\n" "$t" "${c:-0}"
  done
  ;;

# ── compare ─────────────────────────────────────────────────────────────────
compare)
  need_container
  shift
  # -it matters. Without a TTY, `docker exec` does not proxy SIGINT, so Ctrl-C
  # kills the client while the Python inside the container never runs its
  # shutdown path — no verdict printed and no CSV written. Every run before
  # 2026-08-15 20:28 was lost that way.
  ttyflag=""; [ -t 0 ] && ttyflag="-it"

  # No keepalive here any more. It existed to work around loop() blocking in
  # rclc_executor_spin_some, and the firmware fix (timeout 0) removed the need:
  # /wheel_state now runs at 20.3 Hz with nothing publishing to the board. Keep
  # logs/keepalive.py as a fallback if a future flash regresses, but do not run
  # it by default — it publishes /cmd_vel continuously, which keeps the 500 ms
  # motion watchdog permanently fed and would mask a teleop fault.
  kill_match 'keepalive.py'
  docker exec $ttyflag "$NAME" bash -lc "$ENVSET python3 $SRC/nodes/compare.py $*"
  ;;

# ── status ──────────────────────────────────────────────────────────────────
values)
  need_container
  rexec "python3 $SRC/nodes/values.py"
  ;;

status)
  need_container
  echo "  layer     topic                                    rate      want"
  echo "  ------------------------------------------------------------------"
  # EVERY layer, not just the first three. A status command that stops at
  # `wheels` cannot answer "what is alive", which is the only thing it is for.
  for row in \
      "camera:$CAM_NS/infra1/image_rect_raw:15" \
      "camera:$CAM_NS/depth/image_rect_raw:10" \
      "pose:/vo/odom:10" \
      "pose:/gyro/base:50" \
      "wheels:/wheel_state:15" \
      "fused:/odom:15" \
      "map:/nvblox_node/static_occupancy_grid:1" \
      "nav:/global_costmap/costmap:0.5" \
      "nav:/local_costmap/costmap:1" \
      "view:/rover/model:0.5"; do
    l=${row%%:*}; rest=${row#*:}; t=${rest%:*}; want=${rest##*:}
    r=$(rate_of "$t")
    if awk "BEGIN{exit !($r >= $want)}"; then v="OK"; else
      if awk "BEGIN{exit !($r > 0)}"; then v="LOW"; else v="--"; fi
    fi
    printf '  %-9s %-40s %6.1f  %5s %s\n' "$l" "$t" "$r" "$want" "$v"
  done

  # cuVSLAM can be publishing at 30 Hz and still be lying. It has diverged three
  # times (TODO 21) and the fallback to dead reckoning is SILENT: every rate
  # above stays green while the pose runs open-loop. So status has to look at the
  # health payload, not just the rates -- and it cannot do that with `ros2 topic
  # echo`, which TRUNCATES that JSON. health.py subscribes properly.
  echo
  rexec "python3 $SRC/nodes/health.py" || true
  ;;

logs)
  need_container
  docker exec "$NAME" bash -lc "tail -n 60 -f /tmp/${2:-camera}.log"
  ;;

stop)
  docker rm -f "$NAME" >/dev/null 2>&1 && echo "  container removed" || echo "  nothing running"
  ;;

selftest)
  python3 "$HOSTSRC/nodes/vo_node.py" --self-test
  ;;

*)
  sed -n '2,12p' "$0" | sed 's/^# \?//'
  ;;
esac
