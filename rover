#!/usr/bin/env bash
# rover — Phase 1 bring-up, one layer at a time.
#
#   ./rover camera     the D555, and nothing else
#                      --floor  measure its pitch/roll/height off the floor (moves nothing)
#                      --lidar  measure it against the LiDAR, one pose per run; --solve (moves nothing)
#   ./rover pose       + visual odometry and the gyro
#   ./rover lidar      RPLidar C1 -> /scan, and its base_link -> laser TF
#                      --yaw    measure LIDAR_YAW off a target at the nose
#                      --watch  live: hold a box at the nose and read it
#                      --calibrate  DRIVES 0.20 m and measures the yaw itself
#   ./rover goto X Y [DEG]  DRIVES: an exact (x, y, θ) move, learned slide, LiDAR-checked (M4)
#   ./rover navto X Y DEG [--exact]  DRIVES: nav2 route, then goal_exec's exact finish (M5)
#   ./rover drive      DRIVES: exact short moves that plan around the pivot fault
#   ./rover wheels     check the ESP32 link (diagnose only; cannot fix from here)
#                      --nudge  MOVES ~7 cm: proves the motors are powered, not just the link
#   ./rover record S   bag one test scenario (SENSOR_FUSION_PLAN.md §5); straight/pivot90/... DRIVE
#   ./rover grade      score every pose estimate in a run against LiDAR truth (--summary)
#   ./rover values     every sensor's current reading, in one place
#   ./rover status     what is alive right now
#   ./rover fused      LiDAR odometry + fusion2 -> /odom + TF, what nav2 consumes
#   ./rover slam       + the lidar correction: slam_toolbox -> map -> odom, /map
#   ./rover map        nvblox — build the room as it drives (Phase 2)
#   ./rover nav        nav2 — click a goal, it plans and drives there (Phase 3)
#   ./rover vlm        VLM pixel -> Nav2 goal bridge, for the Pi 5 brain (Phase 4)
#   ./rover rviz       view it on the Jetson's own screen (costs GPU)
#   ./rover view       RViz on the laptop (--restart to re-read the config) — finds it on DHCP, checks it renders
#   ./rover up         everything above, in order, + ESP32 + Pi 5 + Studio + view.
#                      Add --voice to also bring up Pi 5 STT/TTS and the speaker.
#                      Tears down and restarts the container — do not run this
#                      against a stack that is already up and working.
#   ./rover voice      Pi 5 STT/TTS + the speaker, on its own (safe any time —
#                      it touches nothing on the Jetson and skips if already up)
#   ./rover logs <n>   tail a layer's log (camera|vo|gyro|fused|lidar|slam)
#   ./rover stop       tear the container down
#
# WHY LAYERS. Four machines and a camera that can be knocked offline by being
# poked at. If everything starts at once, a failure is a wall of log with no
# owner. Each layer here starts alone and prints its own PASS/FAIL, so the
# failure names itself.
set -eo pipefail

IMAGE=${IMAGE:-orin-nav:1.1}
NAME=${NAME:-rover}
LAPTOP_USER=${LAPTOP_USER:-rakhi24}   # LAPTOP_IP is DISCOVERED, not fixed: DHCP moves it
PI5_HOST=${PI5_HOST:-192.168.1.16}    # fixed — unlike the laptop, not on DHCP
BT_SPEAKER=${BT_SPEAKER:-D6:AA:BB:59:EF:B6}  # boAt Stone 650
SRC=/opt/rover
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOSTSRC="$REPO/phase1"
SRC2=/opt/rover2
SRC3=/opt/rover3
SRC4=/opt/rover4
# The RPLidar C1 driver (sllidar_ros2) is COMPILED, not a script, so it lives in
# its own colcon workspace under lidar/ws, built by lidar/build.sh INSIDE this
# same image (never installed into it) and mounted at the path it was built at.
LIDAR=/opt/lidar
# The plain node, not /dev/serial/by-id/...: the Slamtec SDK refuses the symlink
# (error 80008004) but opens the node it points at. It is the only CP210x here.
LIDAR_PORT=${LIDAR_PORT:-/dev/ttyUSB0}
# base_link -> laser, base_link -> camera0_link and the rest of the fixed frames
# live in description/params.yaml; robot_state_publisher serves them (tf_up
# below). The laser's position is measured (2026-09-24); which way the C1's zero
# beam points is NOT marked on the case, so its yaw is measured by driving:
# MEASURED 2026-09-22 by `./rover lidar --calibrate`: +1.5463 rad, +88.60 deg.
#
# Six driven legs (three out-and-back pairs of 0.20 m), five usable, spread
# 0.76 deg, ICP residuals 0.5-0.7 cm. Out and back bias any drive curvature in
# opposite directions, so averaging the pair cancels most of it.
#
# The mount is genuinely 1.4 deg off a clean quarter turn -- that is larger
# than the 0.76 deg spread, so it is skew, not noise. Do not "tidy" this to
# pi/2: 1.4 deg of residual is exactly what slam_toolbox turns into a rotating
# correction that grows with every heading change.
#
# Two earlier values were guesses from descriptions of the RViz picture (0.0,
# then -1.5708) and BOTH were wrong -- the sign was inverted. The lidar and the
# wheels agreeing on the distance of the same move is what makes this one
# trustworthy; nobody's eyes are in the loop.
#
# That value is lidar.yaw in description/params.yaml. `LIDAR_YAW=<rad> ./rover
# lidar` still overrides it for one run, to try a value before recording it.
# Seconds to ADD to every /scan stamp. MEASURED 2026-09-23 by
# `./rover lidar --lag`: three runs, +68 / +94 / +85 ms, same sign every time,
# no fixed bias. sllidar_node reads now() BEFORE blocking for the next full
# revolution, so its stamps lead the measurement by most of a scan period.
# slam_toolbox looks the pose up at the stamp, so during a turn every scan was
# matched against a pose ~0.6 deg away, in the direction of the turn -- and two
# +90 turns left slam with an 8 deg heading correction that odometry and
# direct wall registration both said was wrong. Needs the patched driver
# (lidar/patches/, applied by lidar/build.sh).
LIDAR_TIME_OFFSET=${LIDAR_TIME_OFFSET:-0.082}
CAM_NS=/camera/camera0

# The cuvslam wheel ships its own libcuvslam.so and CUDA-12 userspace libs, and
# they must come BEFORE Isaac ROS's own build in /opt/ros/jazzy — that one is
# compiled for Thor and will not run on this Orin.
CU=/usr/local/lib/python3.12/dist-packages
CU12="$CU/cuvslam:$CU/nvidia/cuda_runtime/lib:$CU/nvidia/cublas/lib:$CU/nvidia/cusolver/lib:$CU/nvidia/cusparse/lib:$CU/nvidia/nvjitlink/lib:$CU/nvidia/nvtx/lib"

# A stale ROS_DISCOVERY_SERVER makes nodes silently invisible to each other,
# which looks exactly like a crashed node. Clear it on every command.
ENVSET='unset ROS_DISCOVERY_SERVER FASTRTPS_DEFAULT_PROFILES_FILE; export ROS_DOMAIN_ID=0; source /opt/ros/jazzy/setup.bash;'

dexec(){ docker exec -d "$NAME" bash -lc "$ENVSET $1"; }
rexec(){ docker exec    "$NAME" bash -lc "$ENVSET $1"; }
running(){ [ "$(docker inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null)" = "true" ]; }
die(){ echo "  ✗ $*" >&2; exit 1; }
kill_match(){ docker exec "$NAME" bash -lc "for p in \$(pgrep -f '$1'); do kill -9 \$p 2>/dev/null; done; true" >/dev/null 2>&1 || true; }

# Every fixed frame on the rover -- base_link -> camera0_link, laser, wheels,
# chassis -- from ONE robot_state_publisher serving the URDF that
# description/build.py derives from params.yaml at this moment (never a stale
# generated file). It replaces two static_transform_publishers, one per layer,
# whose kill patterns once took each other out and lost the laser frame.
# Idempotent: both the pose and lidar layers call it, and a restart republishes
# the same latched /tf_static.
tf_up(){
  local f; f=$(mktemp) || die "mktemp"
  python3 "$REPO/description/build.py" --rsp "$f" ${LIDAR_YAW:+--lidar-yaw "$LIDAR_YAW"} \
    || { rm -f "$f"; die "description/build.py --rsp failed -- is description/params.yaml valid?"; }
  docker cp "$f" "$NAME":/tmp/rover_rsp.yaml >/dev/null; rm -f "$f"
  kill_match 'child-frame-id camera0_link'   # the old per-layer publishers
  kill_match 'child-frame-id laser'
  kill_match '[r]obot_state_publisher'
  dexec "exec ros2 run robot_state_publisher robot_state_publisher --ros-args \
            --params-file /tmp/rover_rsp.yaml > /tmp/rsp.log 2>&1"
  sleep 2
}

need_container(){ running || die "no container. Run: ./rover camera"; }

# Host env does NOT reach `docker exec bash -lc` -- that is how `SLAM=false
# ./rover pose` silently did nothing for months. The motion tools read these,
# so forward the ones that are SET, and only those: an empty value would
# override a tool's own default with "".
pivot_env(){
  local v out=""
  for v in PIVOT_ANCHOR PIVOT_X PIVOT_Y PIVOT_WZ; do
    [ -n "${!v:-}" ] && out="$out $v=${!v}"
  done
  echo "$out"
}

# Measure a topic's rate. Rates are the honest signal: every failure this rig
# has had was a rate collapsing, not a topic disappearing.
rate_of(){
  rexec "timeout 12 ros2 topic hz $1 --window 20 2>/dev/null | awk '/average rate/{r=\$3} END{print r+0}'" 2>/dev/null || echo 0
}

assert_rate(){ # topic  min_hz  label
  local hz; hz=$(rate_of "$1")
  local ok; ok=$(awk -v a="$hz" -v b="$2" 'BEGIN{print (a>=b)?1:0}')
  printf '      %-22s %7.1f Hz   (want >= %s)   %s\n' "$3" "$hz" "$2" \
    "$([ "$ok" = 1 ] && echo OK || echo FAIL)"
  [ "$ok" = 1 ]
}

# A rate proves a topic is publishing. It cannot prove the pose it carries is
# REAL. cuVSLAM's failure mode is silent (TODO 21, four occurrences): it drops
# to gyro-plus-wheel dead reckoning and /odom carries on at 20 Hz with every
# rate gate green -- one session ran 21 m that way unnoticed. health.py
# subscribes to /fusion/status properly (`ros2 topic echo` truncates that JSON)
# and answers the only question the rates cannot.
pose_honest(){ rexec "python3 $SRC/nodes/health.py"; }

start_container(){
  docker rm -f "$NAME" >/dev/null 2>&1 || true
  mkdir -p "$REPO/logs" "$REPO/maps"
  # phase1/ is mounted READ-ONLY: edit a node on the host, restart the layer,
  # no rebuild. The image has no build recipe, so it must never be modified.
  docker run -d --name "$NAME" --entrypoint /bin/bash \
    --runtime=nvidia --network=host --privileged \
    -e NVIDIA_VISIBLE_DEVICES=all -e NVIDIA_DRIVER_CAPABILITIES=all -e NVIDIA_DISABLE_REQUIRE=1 \
    -e ROS_DOMAIN_ID=0 \
    -v "$HOSTSRC":$SRC:ro \
    -v "$REPO/phase2":$SRC2:ro \
    -v "$REPO/phase3":$SRC3:ro \
    -v "$REPO/phase4":$SRC4:ro \
    -v "$REPO/models":/models:ro \
    -v "$REPO/lidar":$LIDAR:ro \
    -v "$REPO/maps":/maps \
    -v "$REPO/logs":/logs \
    "$IMAGE" -c 'sleep infinity' >/dev/null
  sleep 2
}

# The D555 answers ping while completely dead — it is a network device speaking
# DDS, not a USB camera. The only real check is a live publisher on infra1.
cam_ready(){
  rexec "n=\$(ros2 topic info $CAM_NS/infra1/image_rect_raw 2>/dev/null | awk '/Publisher count/{print \$3}'); [ \"\${n:-0}\" -ge 1 ]" >/dev/null 2>&1
}

case "${1:-}" in

# ── camera ──────────────────────────────────────────────────────────────────
camera)
  # --floor measures the camera's pitch, roll and height from the floor plane
  # in its own depth (phase1/nodes/floor_calib.py). Needs the layer up; moves
  # nothing; writes nothing -- it prints the params.yaml lines.
  if [ "${2:-}" = "--floor" ]; then
    need_container
    rexec "python3 $SRC/nodes/floor_calib.py"; exit
  fi
  # --lidar [--solve|--reset] measures the camera against the LiDAR, one
  # hand-placed pose per run (phase1/nodes/cam_lidar_calib.py). Moves nothing.
  if [ "${2:-}" = "--lidar" ]; then
    need_container
    rexec "python3 $SRC/nodes/cam_lidar_calib.py ${3:-}"; exit
  fi
  start_container
  echo "[camera] D555 — stereo IR + depth + motion"
  echo "         emitter OFF and sync OFF; both are load-bearing, see phase1/README.md"
  dexec 'printf "{\"context\":{\"dds\":{\"enabled\":true,\"domain\":0}}}" > ~/.realsense-config.json;
         export LD_LIBRARY_PATH=/root/librealsense/install/lib:$LD_LIBRARY_PATH;
         exec ros2 launch realsense2_camera rs_launch.py camera_name:=camera0 \
            enable_infra1:=true enable_infra2:=true depth_module.infra_profile:=896x504x30 \
            depth_module.emitter_enabled:=false depth_module.laser_power:=0.0 \
            enable_depth:=true enable_color:=true rgb_camera.color_profile:=424x240x15 \
            align_depth.enable:=true \
            enable_motion:=true enable_sync:=false > /tmp/camera.log 2>&1'
  t=0
  until cam_ready; do
    t=$((t+3)); [ "$t" -ge 40 ] && { echo "  ✗ D555 not streaming after 40 s."
      docker exec "$NAME" grep -q "No RealSense devices were found" /tmp/camera.log 2>/dev/null \
        && echo "    Its on-camera DDS server is offline. It still answers ping; that means nothing."
      echo "    Only a physical PoE power-cycle (unplug ~5 s) recovers this."
      echo "    Container left up so you can retry: ./rover camera"; exit 1; }
    sleep 3
  done
  echo "      D555 streaming — OK"

  # The emitter MUST be off, and a launch argument is not proof that it is.
  # `emitter_enabled:=0` looks like it works and does nothing: the parameter is
  # a Boolean and the string "0" does not parse as false, so the driver silently
  # keeps its default of ON. That cost a session — the projector is bolted to the
  # camera, so its dots move with the rig, the scene looks static, and cuVSLAM
  # under-read a 60 cm push as 1.1 cm. Set it at runtime and READ IT BACK.
  #
  # Retry it. Streaming coming up does NOT mean the camera's control channel is
  # ready: seen 2026-08-15, `ros2 param set` returned
  #   "timeout waiting for reply: {"id":"set-option","option-name":"Emitter Enabled"}"
  # on every attempt while infra1 was streaming perfectly at 30 Hz. The device
  # answers image traffic before it answers option traffic, so attaching too soon
  # after a power-cycle leaves the emitter stuck on with everything else looking
  # healthy. Give it up to ~30 s.
  em=""
  for a in 1 2 3 4 5 6; do
    rexec "ros2 param set /camera/camera0 depth_module.emitter_enabled false; \
           ros2 param set /camera/camera0 depth_module.laser_power 0.0" >/dev/null 2>&1 || true
    em=$(rexec "ros2 param get /camera/camera0 depth_module.emitter_enabled" 2>/dev/null | tail -1)
    case "$em" in *False*) break ;; esac
    [ "$a" -lt 6 ] && { echo "      emitter still on, control channel not ready — retry $a/5"; sleep 5; }
  done
  case "$em" in
    *False*) echo "      IR emitter OFF — verified" ;;
    *)       echo "  ✗ IR EMITTER IS STILL ON ($em)."
             echo "    Visual odometry will under-read badly. Do not trust any pose."
             echo "    The camera is half-alive: it streams but will not accept options."
             echo "    Power-cycle the D555, wait 30 s for it to finish booting, retry."
             exit 1 ;;
  esac
  echo
  echo "  GATE camera:"
  assert_rate "$CAM_NS/infra1/image_rect_raw" 15 "IR left"  || true
  assert_rate "$CAM_NS/depth/image_rect_raw"  10 "depth"    || true
  echo
  echo "  Next: ./rover pose"
  ;;

# ── pose ────────────────────────────────────────────────────────────────────
# SLAM (loop closure) is ON by default now that Phase 1 has its drift numbers.
# It publishes map -> odom; odom -> base_link stays continuous and owned by
# fusion2, so a loop closure cannot look like the teleports the fusion
# rejects. Run with SLAM=false ./rover pose to measure raw drift again.
pose)
  need_container
  echo "  checking the camera is still healthy before building on it..."
  assert_rate "$CAM_NS/infra1/image_rect_raw" 15 "IR left" || die "camera unhealthy — fix that first"

  # base_link -> camera0_link must exist BEFORE the pose starts, or the first
  # poses land in a frame tree with a missing link.
  # camera0_link is the D555's LEFT IR imager, not the case centre -- see
  # description/README.md for why its y is -0.0475 on a centred camera.
  echo "[pose] fixed frames from description/params.yaml (robot_state_publisher)"
  tf_up

  echo "[pose] visual odometry  (stereo IR -> /vo/odom, TF odom -> base_link)"
  kill_match "[v]o_node.py"
  # ${SLAM:-true} is expanded HERE, on the host, not escaped into the container.
  # It used to be \${SLAM:-true}, which `docker exec bash -lc` expanded inside
  # the container where SLAM is never set -- so it always resolved to true and
  # `SLAM=false ./rover pose` did nothing at all, silently. That knob is what
  # hands map -> odom to slam_toolbox, so it has to actually work.
  dexec "export LD_LIBRARY_PATH=$CU12:\$LD_LIBRARY_PATH; exec python3 $SRC/nodes/vo_node.py --ros-args -p publish_tf:=false -p slam:=${SLAM:-true} > /tmp/vo.log 2>&1"

  echo "[pose] gyro  (D555 IMU, re-framed into base_link -> /gyro/base)"
  kill_match "[g]yro_node.py"
  dexec "exec python3 $SRC/nodes/gyro_node.py > /tmp/gyro.log 2>&1"
  sleep 10

  echo
  echo "  GATE pose — rate only. Alive is not the same as HONEST:"
  assert_rate /vo/odom   10 "visual odometry" || true
  assert_rate /gyro/base 50 "gyro"            || true
  echo
  echo "  Now prove it is honest, with a tape measure:"
  echo "      ./rover fused, then ./rover record return  (move it by hand, back to the mark)"
  echo "      ./rover grade                              every estimate vs LiDAR truth"
  ;;

# ── lidar ───────────────────────────────────────────────────────────────────
# Independent of the camera: it only needs the container and the USB port. It
# is a layer of its own so that "no /scan" has one owner and one log.
lidar)
  need_container
  # --yaw measures LIDAR_YAW instead of starting anything: it needs the layer
  # already up, and a target ~50 cm in front of the nose. See lidar/yaw_find.py.
  # --calibrate DRIVES. It is the only lidar subcommand that does, and it is
  # the one that answers the yaw without a human in the loop.
  # --lag TURNS the rover briefly each way and measures whether /scan is
  # stamped when it was measured (lidar/scan_lag.py). slam trusts the stamp.
  if [ "${2:-}" = "--lag" ]; then
    assert_rate /scan 8 "laser scan"  || die "no /scan — run ./rover lidar first"
    assert_rate /odom 15 "fused odom" || die "no /odom — run ./rover fused"
    echo "  THIS TURNS THE ROVER: ~3.5 s each way. Watch it."
    rexec "PIVOT_ANCHOR=hold python3 $LIDAR/scan_lag.py"; exit
  fi
  if [ "${2:-}" = "--calibrate" ]; then
    assert_rate /scan 8 "laser scan"  || die "no /scan — run ./rover lidar first"
    assert_rate /odom 15 "fused odom" || die "no /odom — run ./rover fused"
    assert_rate /wheel_state 15 "wheel link" || die "wheel link down — ./rover wheels"
    echo "  THIS MOVES THE ROVER: 0.20 m forward, 0.07 m/s. Watch it."
    rexec "python3 $LIDAR/yaw_calibrate.py"; exit
  fi
  if [ "${2:-}" = "--yaw" ] || [ "${2:-}" = "--watch" ]; then
    assert_rate /scan 8 "laser scan" || die "no /scan — run ./rover lidar first"
    if [ "${2:-}" = "--watch" ]; then
      # Live. Hold something at the nose and read 'renders at' -- no describing
      # the picture to anyone, no sign to get backwards.
      rexec "python3 $LIDAR/yaw_find.py --watch"; exit
    fi
    echo "  target ~50 cm DIRECTLY in front of the nose, nothing else within 1.5 m:"
    rexec "python3 $LIDAR/yaw_find.py"; exit
  fi
  [ -x "$REPO/lidar/ws/build/sllidar_ros2/sllidar_node" ] \
    || die "driver not built — run: lidar/build.sh   (one-off, ~30 s)"
  [ -e "$LIDAR_PORT" ] || die "no $LIDAR_PORT — is the C1's USB cable in? (lsusb: Silicon Labs CP210x)"
  kill_match '[s]llidar_node'
  echo "[lidar] fixed frames from description/params.yaml (robot_state_publisher)"
  tf_up
  echo "[lidar] RPLidar C1 on $LIDAR_PORT -> /scan  (10 Hz, 720 beams, 0.5 deg)"
  dexec "source $LIDAR/ws/install/setup.bash; exec ros2 run sllidar_ros2 sllidar_node --ros-args \
            -p serial_port:=$LIDAR_PORT -p serial_baudrate:=460800 -p frame_id:=laser \
            -p inverted:=false -p angle_compensate:=true -p scan_mode:=Standard \
            -p scan_time_offset:=$LIDAR_TIME_OFFSET > /tmp/lidar.log 2>&1"
  sleep 5
  echo
  echo "  GATE lidar:"
  assert_rate /scan 8 "laser scan" || {
    rexec "grep -E 'ERROR|health' /tmp/lidar.log | tail -3"; die "no /scan — see ./rover logs lidar"; }
  # Four beams, in the ROBOT's directions, not the lidar's. Trust these only
  # after the yaw has been measured (./rover lidar --yaw).
  #
  # NOT `|| true`: scan_check also asserts base_link -> laser exists, and that
  # is a hard failure. A scan nothing can transform is invisible everywhere
  # except RViz, so if it does not fail here it does not fail anywhere.
  rexec "python3 $LIDAR/scan_check.py" \
    || die "the scan cannot be transformed into base_link — see above"
  echo
  echo "  Orientation check, to the nearest quadrant: put a box ~50 cm in front"
  echo "  of the NOSE and re-run — 'front' must be the reading that drops."
  echo "  To MEASURE the yaw instead of guessing it:   ./rover lidar --yaw"
  ;;

# ── drive ───────────────────────────────────────────────────────────────────
# Exact short moves on a rover that cannot pivot about its centre (TODO 43).
# Plans rotate / straight / rotate around the measured pivot point near the
# left tyres, re-plans from the LiDAR-corrected pose each pass. Map frame.
#   ./rover drive X Y [DEG]        ./rover drive 0 0 90 --rel   (turn in place)
#   ./rover drive --mark NAME      ./rover drive --to NAME
drive)
  need_container
  shift
  if [ "${1:-}" != "--mark" ]; then
    assert_rate /scan 8 "laser scan"  || die "no /scan — run ./rover lidar"
    assert_rate /odom 15 "fused odom" || die "no /odom — run ./rover fused"
    assert_rate /map 0.3 "slam map"   || die "no map frame — run ./rover slam"
    mode=$(timeout 5 curl -s http://192.168.1.16:8091/mode 2>/dev/null)
    case "$mode" in *'"manual": true'*) die "teleop is in MANUAL — it streams zeros over every command. Tap AUTO." ;; esac
    echo "  THIS DRIVES THE ROVER. Watch it; the LiDAR is blind below 21 cm."
  fi
  rexec "$(pivot_env) python3 $SRC3/nodes/pivot_goto.py $*"
  ;;

# ── wheels ──────────────────────────────────────────────────────────────────
wheels)
  need_container
  # --nudge MOVES the rover ~7 cm. The rate gate below proves the ESP32 is
  # TALKING; it cannot prove the motors are POWERED. On 2026-09-23 the rate
  # was a healthy 20 Hz, the firmware echoed every command back in
  # /wheel_state.z, and the wheels read exactly zero -- the motor supply to
  # the BTS7960s was not on. `./rover up` printed "Wheels are live" over it.
  if [ "${2:-}" = "--nudge" ]; then
    echo "  THIS MOVES THE ROVER ~7 cm forward. Watch it."
    rexec "python3 $SRC/nodes/nudge.py"; exit
  fi
  echo "[wheels] ESP32 -> micro-ROS agent (Pi 5) -> /wheel_state"
  echo "         firmware publishes at 20 Hz whenever it is AGENT_CONNECTED,"
  echo "         with no motion gating — so a low rate never means 'it was parked'."
  echo
  assert_rate /wheel_state 15 "wheel_state" && { echo; echo "  Wheels are live."; exit 0; }
  echo
  echo "  ✗ Wheel odometry is not usable. Known state as of 2026-09-06 (TODO §24):"
  echo "      /wheel_state is SILENT — 0 Hz, not the old 1 Hz mismatch from §1."
  echo "      'ros2 node list' on the Pi 5 shows no ESP32 micro-ROS client at all"
  echo "      (only /pi5_tts_node). The board answers ping at 192.168.1.3 and"
  echo "      MicroXRCEAgent is running on the Pi 5 (:8888), so this is the"
  echo "      micro-ROS session itself, not the network or the agent process."
  echo "      This is a REGRESSION from the 20.004 Hz confirmed fixed 2026-08-23 —"
  echo "      cause unknown. nav2 will still plan and issue /cmd_vel correctly;"
  echo "      the wheels just do not turn. Try a power-cycle of the ESP32 first."
  echo
  echo "    Neither the Jetson nor the Pi 5 has a flashing toolchain or USB serial,"
  echo "    so a reflash (if it comes to that) needs your own machine. OTA is"
  echo "    compiled in."
  echo
  ;;

# ── fused ───────────────────────────────────────────────────────────────────
fused)
  need_container
  echo "  checking the pose layer is up before building on it..."
  assert_rate /gyro/base 50 "gyro" || die "no gyro — run ./rover pose first"
  assert_rate /scan 8 "laser scan" || die "no /scan — run ./rover lidar first"
  kill_match 'fusion_node.py'      # the Phase 1 estimator, retired 2026-09-26
  kill_match 'lidar_odom_node.py'
  kill_match 'fusion2_node.py'
  # THE POSE (SENSOR_FUSION_PLAN.md M2 + M3). lidar_odom_node matches every
  # scan against the room (/lidar/odom, no TF); fusion2 combines it with the
  # gyro, VO and wheels, each weighted by its own evidence, and owns /odom and
  # odom -> base_link. vo_node runs with publish_tf:=false: one owner per TF.
  echo "[fused] LiDAR odometry -> /lidar/odom"
  dexec "python3 $SRC/nodes/lidar_odom_node.py > /tmp/lidarodom.log 2>&1"
  echo "[fused] fusion2 -> /odom, TF odom -> base_link, /fusion/status, /fusion/path"
  dexec "python3 $SRC/nodes/fusion2_node.py > /tmp/fusion2.log 2>&1"
  sleep 5
  echo
  echo "  GATE fused:"
  assert_rate /lidar/odom 8 "lidar odom" || true
  assert_rate /odom 15 "fused odom" || true
  echo
  pose_honest || {
    echo
    echo "  ✗ Do NOT run ./rover map or nav on this pose until it reads ok:"
    echo "    nvblox writes depth wherever the pose claims the robot is."
  }
  echo
  echo "  Test it against LiDAR truth:  ./rover record <scenario>; ./rover grade"
  ;;

# ── slam ────────────────────────────────────────────────────────────────────
# The lidar's job in the pose stack. fusion2 is LiDAR-anchored odometry but still
# correct itself; slam_toolbox matches every scan against the walls and
# publishes what dead reckoning got wrong as map -> odom. Nothing under it
# changes: odom -> base_link is fusion2's, nav2 still plans in odom
# until it is deliberately moved to map (that is a separate, driven change --
# see phase2/config/SLAM.md). What this layer gives you today is the corrected pose
# (map -> base_link), a 2D map of the room on /map, and both in RViz.
slam)
  need_container
  case "${2:-}" in
    --check) rexec "python3 $SRC2/config/slam_check.py"; exit ;;
    --save)
      [ -n "${3:-}" ] || die "usage: ./rover slam --save <name>   (written to maps/<name>.posegraph + .yaml/.pgm)"
      mkdir -p "$REPO/maps"
      rexec "cd /maps && ros2 service call /slam_toolbox/serialize_map slam_toolbox/srv/SerializePoseGraph \"{filename: '/maps/$3'}\" >/dev/null \
             && ros2 run nav2_map_server map_saver_cli -f /maps/$3 --ros-args -p map_subscribe_transient_local:=true >/dev/null 2>&1" \
        && echo "  saved maps/$3.posegraph (+ .data) and maps/$3.pgm/.yaml" || die "save failed — is ./rover slam up?"
      exit ;;
  esac
  echo "  checking the fused pose and the lidar are up before correcting them..."
  assert_rate /odom 15 "fused odom" || die "no fused pose — run ./rover fused"
  assert_rate /scan  8 "laser scan" || die "no /scan — run ./rover lidar"

  # ONLY ONE THING MAY OWN map -> odom. cuVSLAM publishes it whenever vo_node
  # runs with slam:=true, which is ./rover pose's DEFAULT (SLAM:-true) -- so on
  # a normal bring-up the frame already has an owner before slam_toolbox starts.
  #
  # Two publishers of one transform is the failure the Phase 1 fusion's docstring
  # already describes for odom -> base_link: TF goes non-deterministic and the
  # rover jitters between two poses with nothing in any log. Here it would be
  # worse than confusing -- the two corrections disagree by construction, one
  # from visual loop closure and one from scan matching, so the pose would flip
  # between them at the TF publish rate.
  #
  # slam_toolbox is the one we want: it corrects against walls, every scan,
  # rather than only when cuVSLAM recognises a place (15-27 closures a session
  # since TODO 23 -- READINESS.md). So cuVSLAM's must be turned off, not this one.
  if docker exec "$NAME" bash -lc 'pgrep -af "[v]o_node.py" | grep -q "slam:=true"' 2>/dev/null; then
    echo
    echo "  ✗ cuVSLAM is already publishing map -> odom (vo_node has slam:=true)."
    echo "    Two owners of one transform makes TF non-deterministic — the pose"
    echo "    would flip between visual loop closure and scan matching."
    echo
    echo "    slam_toolbox should own it: it corrects against walls on every"
    echo "    scan, where cuVSLAM only corrects when it recognises a place."
    echo
    echo "    Hand it over, in this order:"
    echo "        SLAM=false ./rover pose     # cuVSLAM keeps tracking, stops correcting"
    echo "        ./rover fused"
    echo "        ./rover slam"
    exit 1
  fi
  kill_match '[a]sync_slam_toolbox_node'
  echo "[slam] slam_toolbox (online async, mapping) -> map -> odom TF, /map"
  dexec "exec ros2 launch slam_toolbox online_async_launch.py \
            slam_params_file:=$SRC2/config/slam_toolbox.yaml use_sim_time:=false autostart:=true > /tmp/slam.log 2>&1"
  sleep 8
  echo
  echo "  GATE slam:"
  assert_rate /map 0.3 "lidar map" || { rexec "grep -iE 'error|fail' /tmp/slam.log | tail -3"; die "no /map — see ./rover logs slam"; }
  rexec "python3 $SRC2/config/slam_check.py" || true
  echo
  echo "  The correction row is what the lidar changed. Drive a zig-zag and a"
  echo "  couple of pivots, then re-run:   ./rover slam --check"
  echo "  In RViz (./rover view) the 'Lidar map' display is this node's room."
  echo "  Save the room once it is complete:  ./rover slam --save <name>"
  ;;

# ── map ─────────────────────────────────────────────────────────────────────
map)
  need_container
  echo "  checking the fused pose is up before building a map on it..."
  assert_rate /odom 15 "fused odom" || die "no fused pose — run ./rover fused first"
  # Rate alone is not enough to start mapping on. A diverged cuVSLAM still
  # publishes /odom at 20 Hz, and nvblox integrates depth at whatever pose it is
  # handed -- so a bad pose does not degrade the map, it corrupts it, and the
  # only fix is to throw the map away and redrive the lap. Cheap check, expensive
  # mistake.
  pose_honest || die "the pose is dead reckoning, not tracking — mapping on it would
    smear the map permanently. Fix it first:  ./rover pose  THEN  ./rover fused
    (./rover fused alone restarts fusion and NOT cuvslam, so divergence survives)"
  kill_match 'nvblox_node'
  echo "[map] nvblox — depth + the FUSED pose -> TSDF mesh and a 2D floor slice"
  echo "      built on /odom, not raw cuvslam: nvblox writes depth wherever the"
  echo "      pose claims the robot is, so a teleport smears the map permanently."
  dexec "ros2 launch $SRC2/launch/nvblox.launch.py > /tmp/map.log 2>&1"
  # nvblox allocates GPU hash tables and warms up its integrators before it
  # publishes anything; checked too early it reads 0 Hz and looks broken.
  sleep 25
  echo
  echo "  GATE map:"
  # static_occupancy_grid, NOT static_map_slice: that name carries an
  # nvblox_msgs/DistanceMapSlice, while the nav_msgs/OccupancyGrid RViz and
  # nav2 want is this one.
  assert_rate /nvblox_node/static_occupancy_grid 1 "2D occupancy grid" || true
  assert_rate "/nvblox_node/back_projected_depth/camera0_depth_optical_frame" 5 "depth integrated" || true
  echo
  echo "  How much is mapped:"
  rexec "python3 $SRC2/tools/map_stats.py" 2>/dev/null | sed -n "/grid/,/occupied/p" | sed "s/^/    /"
  echo
  echo "  Drive it and the map grows. In RViz: nvblox mesh, nvblox 2D slice."
  echo "  Log: ./rover logs map"
  ;;

# ── nav ─────────────────────────────────────────────────────────────────────
nav)
  need_container
  echo "  checking the pose and the map are up before planning on them..."
  assert_rate /odom 15 "fused odom" || die "no fused pose — run ./rover fused"
  assert_rate /nvblox_node/static_occupancy_grid 1 "map" || die "no map — run ./rover map"
  kill_match 'nav2_|lifecycle_manager|controller_server|planner_server|bt_navigator'
  echo "[nav] nav2 — plan a route on the nvblox map and drive it"
  echo "      frame is odom, not map: this navigates within one session."
  echo "      Spin recovery and rotate-to-heading are ON since TODO 40 — the"
  echo "      pivot fault (TODO 14) was fixed on 2026-08-22. Recovery order is"
  echo "      clear costmaps → spin +90° → back up 0.30 m → spin −90° → wait."
  echo "      Footprint 36 x 38 cm + 5 cm padding: the planner needs a gap over"
  echo "      ~0.46 m in its 5 cm cells (a real 48 cm gap is borderline)."
  dexec "ros2 launch $SRC3/launch/nav2.launch.py > /tmp/nav.log 2>&1"
  sleep 20
  echo
  echo "  GATE nav:"
  assert_rate /global_costmap/costmap 0.5 "global costmap" || true
  assert_rate /local_costmap/costmap 1 "local costmap" || true
  echo
  echo "  Now set a goal: in RViz use the '2D Goal Pose' tool, or"
  echo "    ros2 topic pub --once /goal_pose geometry_msgs/PoseStamped ..."
  echo "  Log: ./rover logs nav"
  ;;

# ── vlm ─────────────────────────────────────────────────────────────────────
# The Jetson half of "go to the red bottle": the Pi 5 brain's VLM picks a
# pixel in the color frame, this turns that pixel into a Nav2 goal. See
# phase4/nodes/pixel_to_goal.py for the full contract and why it's odom-
# framed, not map-framed like the code it bridges to expects.
vlm)
  need_container
  echo "  checking the fused pose is up before bridging vision to a goal..."
  assert_rate /odom 15 "fused odom" || die "no fused pose — run ./rover fused"
  kill_match 'image_bridge.py|pixel_to_goal.py'
  echo "[vlm] image_bridge — color frame -> JPEG, for the Pi 5's look()/VLM"
  dexec "exec python3 $SRC4/nodes/image_bridge.py > /tmp/image_bridge.log 2>&1"
  echo "[vlm] pixel_to_goal — VLM pixel + depth -> odom-frame Nav2 goal"
  dexec "exec python3 $SRC4/nodes/pixel_to_goal.py > /tmp/pixel_to_goal.log 2>&1"
  sleep 4
  echo
  echo "  GATE vlm:"
  assert_rate /camera/color/image_raw/compressed 2 "compressed color (for Pi5)" || true
  rexec "n=\$(ros2 topic info /vision/pixel_query 2>/dev/null | awk '/Subscription count/{print \$3}'); \
         printf '      %-22s %7s        (want >= 1)   %s\n' 'pixel_to_goal listening' \"\${n:-0}\" \"\$([ \"\${n:-0}\" -ge 1 ] && echo OK || echo FAIL)\""
  echo
  echo "  This does not drive anything by itself — it only answers queries."
  echo "  The Pi 5's approach_described_object() tool is what triggers a drive."
  echo "  Log: ./rover logs image_bridge   or   ./rover logs pixel_to_goal"
  ;;

# ── up: the whole fleet, one command ────────────────────────────────────────
# This restarts the container (start_container does `docker rm -f` first), so
# it is for a cold power-on, not for topping up a stack that is already
# running well — running it against a healthy stack throws the healthy state
# away for no reason.
up)
  echo "═══ full bring-up: camera → lidar → pose → fused → slam → map → nav → vlm → wheels → Pi5 → Studio → view ═══"
  for layer in camera lidar pose fused slam map nav vlm; do
    echo
    # pose runs with SLAM=false so cuVSLAM does NOT publish map -> odom. Only
    # one thing may own that transform, and in this sequence slam_toolbox is
    # the one that does -- it corrects against walls on every scan, where
    # cuVSLAM only corrects when it recognises a place. Without this, `up`
    # brings pose up with loop closure on (its default) and the `slam` step
    # two lines later refuses, so the whole bring-up stops half done.
    if [ "$layer" = pose ]; then SLAM=false "$0" pose || die "'pose' failed — fix it (see above). Re-run: ./rover up"
    else "$0" "$layer" || die "'$layer' failed — fix it (see above) before continuing. Re-run: ./rover up"
    fi
  done

  echo
  echo "[wheels] ESP32 link — first check"
  "$0" wheels || true

  echo
  echo "[pi5] teleop + agent_node"
  procs=$(timeout 8 ssh -o BatchMode=yes -o ConnectTimeout=4 "$LAPTOP_USER@$PI5_HOST" \
    'pgrep -af "teleop_we[b]|agent_[n]ode"' 2>/dev/null)
  if [ -n "$procs" ]; then
    echo "      teleop + agent_node running"
  else
    echo "      ✗ teleop and/or agent_node not found on the Pi 5 — check it by hand"
  fi
  mode=$(timeout 8 curl -s "http://$PI5_HOST:8091/mode" 2>/dev/null)
  case "$mode" in
    *'"manual": false'*|*'"manual":false'*) echo "      teleop: AUTO — OK" ;;
    *) echo "      ✗ teleop not in AUTO ($mode) — MANUAL streams zeros and cancels nav2. Flip it." ;;
  esac

  echo
  echo "[studio] LangGraph Studio on the Pi 5"
  # timeout + -n: this ssh does not return on its own, the launched server
  # holds the channel's fds open. Safe to cut — start_studio.sh is detached.
  timeout 15 ssh -n -o BatchMode=yes "$LAPTOP_USER@$PI5_HOST" \
    'setsid nohup ~/ros2_ws/scripts/start_studio.sh > /tmp/langgraph_dev.log 2>&1 < /dev/null &' \
    2>/dev/null || true
  studio_ok=""
  for i in 1 2 3 4 5 6; do
    sleep 5
    studio_ok=$(timeout 5 ssh -o BatchMode=yes "$LAPTOP_USER@$PI5_HOST" \
      'curl -s http://127.0.0.1:2024/ok' 2>/dev/null)
    [ "$studio_ok" = '{"ok":true}' ] && break
  done
  if [ "$studio_ok" = '{"ok":true}' ]; then
    echo "      ready — BOTH steps, the link alone is blocked as mixed content:"
    echo "        1. ssh -N -L 2024:localhost:2024 $LAPTOP_USER@$PI5_HOST"
    echo "        2. open https://smith.langchain.com/studio/?baseUrl=http://127.0.0.1:2024"
  else
    echo "      ✗ not up after 30s — check on the Pi 5: tail /tmp/langgraph_dev.log"
  fi
  echo
  echo "[langsmith] traces of real turns — cloud, already recording, no tunnel"
  echo "        https://smith.langchain.com  ->  project 'pi5'"
  echo "        Spoken turns appear as run 'turn:voice', Telegram as 'turn:telegram',"
  echo "        each with the full node traversal, tool calls and LLM in/out."
  echo "        This is where to watch a voice turn — Studio's thread list only"
  echo "        shows runs its OWN server executed, and agent_node runs voice."
  echo "      NOTE: Studio and agent_node (Telegram) both publish /cmd_vel and only"
  echo "      agent_node gets the nav-done callback. Driving from Telegram? Stop"
  echo "      Studio first and confirm: ros2 node list | grep studio   (empty)"

  if [ "${2:-}" = "--voice" ]; then
    echo
    "$0" voice
  fi

  echo
  "$0" view
  ;;

voice)
    echo "[voice] Pi 5 STT/TTS + $BT_SPEAKER"
    # Bracketed, or the pattern matches the ssh command line carrying it and
    # every run reports "already running" — so --voice never started anything.
    already=$(timeout 8 ssh -o BatchMode=yes "$LAPTOP_USER@$PI5_HOST" \
      'pgrep -af "stt_nod[e]|tts_nod[e]"' 2>/dev/null || true)
    if [ -n "$already" ]; then
      echo "      already running — leaving it alone (a second pair double-speaks)"
    else
      gate=$(bash ~/robot/scripts/fleet_role.sh voice status 2>/dev/null || true)
      echo "      gate: ${gate:-unknown}"
      case "$gate" in
        *stopped*) ;;
        *) echo "      ✗ Jetson's own voice stack is not confirmed stopped — not starting Pi 5 voice." ;;
      esac
      if [ -z "$gate" ] || [[ "$gate" == *stopped* ]]; then
        # timeout, because this ssh does NOT return on its own: the launched
        # process keeps the channel's fds open even under setsid+nohup, so the
        # connection just sits there. Killing it is safe — voice_launch is
        # already detached on the Pi 5 and keeps running.
        timeout 15 ssh -n -o BatchMode=yes "$LAPTOP_USER@$PI5_HOST" 'cd ~/ros2_ws && setsid nohup bash -lc \
          "source /opt/ros/jazzy/setup.bash && source install/setup.bash && \
           ros2 launch pi5_voice_pkg voice_launch.py" \
          > /tmp/voice_launch.log 2>&1 < /dev/null &' 2>/dev/null || true
        # Loading whisper takes ~20s and the gain is re-applied 5s after that,
        # so a blind `sleep 6` reported on a pipeline that wasn't up yet. Wait
        # ON the Pi 5 in ONE ssh: polling from here cost 20 connections, and
        # ssh to this box is slow enough that that alone ran past four minutes.
        timeout 90 ssh -o BatchMode=yes "$LAPTOP_USER@$PI5_HOST" \
          'for i in $(seq 1 40); do
             grep -q "re-applied" /tmp/voice_launch.log 2>/dev/null && break
             sleep 2
           done' 2>/dev/null || true
      fi
    fi
    timeout 8 ssh -o BatchMode=yes "$LAPTOP_USER@$PI5_HOST" \
      'grep -hE "stt_provider =|tts_provider =|wake_detector =|mic gain .* re-applied" \
         /tmp/voice_launch.log | sed "s/.*\] //"' 2>/dev/null | sed 's/^/      /' || true
    conn=$(timeout 8 ssh -o BatchMode=yes "$LAPTOP_USER@$PI5_HOST" \
      "bluetoothctl info $BT_SPEAKER | grep -i connected" 2>/dev/null || true)
    echo "      speaker: ${conn:-unknown}"
    case "$conn" in
      *": yes"*) ;;
      *)
        ssh -o BatchMode=yes "$LAPTOP_USER@$PI5_HOST" "bluetoothctl connect $BT_SPEAKER" >/dev/null 2>&1 || true
        conn=$(timeout 8 ssh -o BatchMode=yes "$LAPTOP_USER@$PI5_HOST" \
          "bluetoothctl info $BT_SPEAKER | grep -i connected" 2>/dev/null || true)
        echo "      speaker retry: ${conn:-unknown}"
        case "$conn" in
          *": yes"*) ;;
          *) echo "      ✗ speaker not connecting — page-timeout means it's off or out of range. Power-cycle it." ;;
        esac
        ;;
    esac
  echo
  echo "  Wake word is OFF (wake_detector: transcript_alias, require_wake:false)"
  echo "  — just talk, every transcript goes to the brain. Watch a turn land:"
  echo "     https://smith.langchain.com  ->  project 'pi5'  ->  run 'turn:voice'"
  ;;

detect)
  need_container
  # Needs the FUSED pose, not just the camera: every detection is deprojected
  # into odom via TF, and a detection in a frame the brain does not navigate in
  # is dropped on arrival (ros2_bridge.on_detections). No pose, no useful output.
  echo "  checking the fused pose is up before placing objects in odom..."
  assert_rate /odom 15 "fused odom" || die "no fused pose — run ./rover fused"
  pose_honest || die "the pose is dead reckoning — objects would be placed in a
    frame that is drifting. Fix it first:  ./rover pose  THEN  ./rover fused"
  [ -f "$REPO/models/yolov8n.pt" ] || die "no model at models/yolov8n.pt.
    Stock YOLOv8n, ~6.5 MB: python3 -c \"from ultralytics import YOLO; YOLO('yolov8n.pt')\"
    and move it there, or copy it off another machine."
  kill_match 'detections_3d.py'
  echo "[detect] YOLOv8n + D555 depth -> odom-frame objects, for the Pi 5 brain"
  echo "         look_feed_rate=0: image_bridge (the vlm layer) owns the JPEG"
  echo "         topic, and two publishers on it would look like a flapping camera."
  dexec "exec python3 $SRC4/nodes/detections_3d.py > /tmp/detections_3d.log 2>&1"
  echo "  loading YOLO onto the GPU (~15 s)..."
  sleep 16
  echo
  echo "  GATE detect:"
  # NOT a rate gate: the node publishes only when it actually sees something,
  # and an empty room is not a fault. The brain agrees -- on_detections has no
  # staleness timeout, it just observes into world_model. So gate on the node
  # being up and listening, then say what it can currently see.
  rexec "n=\$(ros2 topic info /vision/detections_3d 2>/dev/null | awk '/Publisher count/{print \$3}'); \
         printf '      %-26s %5s        (want >= 1)   %s\n' 'detections_3d publishing' \"\${n:-0}\" \"\$([ \"\${n:-0}\" -ge 1 ] && echo OK || echo FAIL)\""
  rexec "n=\$(ros2 topic info /vision/target 2>/dev/null | awk '/Subscription count/{print \$3}'); \
         printf '      %-26s %5s        (want >= 1)   %s\n' 'target hunt listening' \"\${n:-0}\" \"\$([ \"\${n:-0}\" -ge 1 ] && echo OK || echo FAIL)\""
  echo
  echo "  What it can see right now (8 s sample, empty is not a failure):"
  rexec "timeout 8 ros2 topic echo /vision/detections_3d --once 2>/dev/null \
         | python3 -c 'import sys,json,re; d=sys.stdin.read(); m=re.search(r\"objects.:\s*(\[.*?\])\", d, re.S); print(\"      \" + (\", \".join(sorted({o[\\\"label\\\"] for o in json.loads(m.group(1))})) if m else \"nothing in view\"))' 2>/dev/null" \
    || echo "      nothing in view"
  echo
  echo "  This lights up the brain's approach_object, where_is,"
  echo "  list_known_objects, scan_surroundings and the world_model service."
  echo "  Log: ./rover logs detections_3d"
  ;;

# ── rviz ────────────────────────────────────────────────────────────────────
rviz)
  need_container
  echo "[rviz] on the Jetson's own display. Prefer ./rover view on the laptop —"
  echo "       rviz2 here competes with cuVSLAM for the GPU and the pose rate dips."
  xhost +local:docker >/dev/null 2>&1 || true
  docker exec -it -e DISPLAY=:0 "$NAME" bash -lc \
    "$ENVSET rviz2 -d $SRC2/rviz/rover_live.rviz"
  ;;

# ── the laptop view ─────────────────────────────────────────────────────────
view)
  # The laptop is on DHCP and MOVES: .10 on 2026-08-21, .17 on 2026-08-22. So
  # find it rather than hardcode it. It is the host that answers ssh AND has the
  # view script — the Jetson and the Pi 5 both answer ssh too.
  echo "[view] RViz on the laptop"
  # The config's Fixed Frame is `map`, published by slam_toolbox. With slam
  # down there is no map frame and RViz renders an EMPTY WINDOW with an error
  # that reads exactly like a dead publisher -- the same trap the old config
  # avoided by staying in `odom`. Say it here, before the hunt starts.
  if ! docker exec "$NAME" bash -lc "$ENVSET timeout 6 ros2 run tf2_ros tf2_echo map odom 2>&1 | grep -q Translation" 2>/dev/null; then
    echo "  ! no map -> odom transform: ./rover slam is not up."
    echo "    RViz's Fixed Frame is 'map', so the window will be EMPTY until it is."
    echo "    Either run ./rover slam, or set Fixed Frame to 'odom' in the"
    echo "    Displays panel — everything except the room still draws there."
  fi
  ip="${LAPTOP_IP:-}"
  if [ -z "$ip" ]; then
    printf "  looking for the laptop"
    for i in $(seq 2 40); do
      cand="192.168.1.$i"
      [ "$cand" = "$(hostname -I | tr ' ' '\n' | grep '^192\.168\.1\.' | head -1)" ] && continue
      if timeout 1 bash -c "echo > /dev/tcp/$cand/22" 2>/dev/null; then
        if timeout 6 ssh -o BatchMode=yes -o ConnectTimeout=3 "$LAPTOP_USER@$cand" \
             'test -f ~/rover_live.sh' 2>/dev/null; then
          ip="$cand"; break
        fi
      fi
      printf "."
    done
    echo
  fi
  [ -n "$ip" ] || die "no laptop found. Is it on, and awake? Set LAPTOP_IP=x.x.x.x to skip the search."
  echo "  found at $ip"

  # Push the config every time. The laptop used to hold its own copy, which
  # drifted from the repo's and made "I fixed the RViz config" untrue on the
  # only machine that renders it. The repo is the single source; the laptop is
  # a display.
  scp -q -o BatchMode=yes "$(dirname "$0")/phase2/rviz/rover_live.rviz" \
      "$LAPTOP_USER@$ip:~/rover_live.rviz" 2>/dev/null \
    && echo "  config synced from the repo" \
    || echo "  ! could not sync the config — the laptop may be showing an old one"

  # A desktop session must exist. RViz over ssh with nobody logged in renders
  # into nothing and exits 0 — it looks exactly like a data fault, and it cost
  # an evening once. Xwayland's cmdline is the best source for both the display
  # number and the auth cookie; on Wayland `loginctl -p Display` is EMPTY.
  #
  # But Xwayland running is NOT what "logged in" means — it only means some X11
  # client has already asked for one. GNOME starts it ON DEMAND: log in, touch
  # nothing X11, and there is no Xwayland process at all. Reading that as "nobody
  # is logged in" told us to log in to a laptop we were already logged in to, and
  # no amount of logging in would have fixed it. See TODO 35.
  #
  # So when Xwayland is absent, ask the two questions that actually matter: does
  # loginctl show an ACTIVE graphical session, and has mutter left its Xwayland
  # auth cookie waiting in the runtime dir? That cookie is precisely what the
  # on-demand path sets up in advance, and starting rviz2 against it is what
  # spawns Xwayland.
  xw=$(timeout 8 ssh -o BatchMode=yes "$LAPTOP_USER@$ip" 'pgrep -a Xwayland 2>/dev/null | head -1' 2>/dev/null)
  if [ -n "$xw" ]; then
    disp=$(echo "$xw" | grep -oE ' :[0-9]+' | head -1 | tr -d ' ')
    auth=$(echo "$xw" | sed -nE 's/.* -auth ([^ ]+).*/\1/p')
  else
    probe=$(timeout 8 ssh -o BatchMode=yes "$LAPTOP_USER@$ip" '
      for s in $(loginctl list-sessions --no-legend 2>/dev/null | awk "{print \$1}"); do
        [ "$(loginctl show-session "$s" -p Active --value 2>/dev/null)" = yes ] || continue
        case "$(loginctl show-session "$s" -p Type --value 2>/dev/null)" in
          wayland|x11) echo GRAPHICAL; break ;;
        esac
      done
      ls /run/user/$(id -u)/.mutter-Xwaylandauth.* 2>/dev/null | head -1' 2>/dev/null)
    case "$probe" in
      *GRAPHICAL*) ;;
      *)
        echo "  ✗ nobody is logged in at the laptop desktop."
        echo "    RViz cannot render into a login screen. Log in there, then re-run."
        exit 1
        ;;
    esac
    auth=$(echo "$probe" | grep -m1 'mutter-Xwaylandauth' || true)
    disp=":0"
    echo "  Xwayland not started yet — GNOME starts it on demand; starting rviz2"
    echo "  is what spawns it. Someone IS logged in; loginctl says so."
  fi
  # An x11 session leaves no mutter cookie; an empty XAUTHORITY is worse than an
  # absent one, so name the default rather than exporting nothing.
  [ -n "$auth" ] || auth='$HOME/.Xauthority'
  echo "  display ${disp:-:0}"

  # RViz reads its config ONCE, at startup. "already running" therefore means
  # it is showing whatever the config said when it started, which after any
  # edit to rover_live.rviz is the old picture -- and the sync above prints
  # "config synced" either way, so it looks like it took. `./rover view
  # --restart` is how you actually apply a config change.
  if [ "${2:-}" = "--restart" ]; then
    echo "  --restart: stopping rviz2 so the synced config is re-read"
    timeout 8 ssh -o BatchMode=yes "$LAPTOP_USER@$ip" 'pkill -x rviz2' 2>/dev/null || true
    sleep 2
  fi

  # pgrep -x, never -f: -f matches our own ssh command line and always "succeeds".
  if timeout 8 ssh -o BatchMode=yes "$LAPTOP_USER@$ip" 'pgrep -x rviz2 >/dev/null' 2>/dev/null; then
    echo "  already running — look at the laptop screen"
    echo "  (config changed? it is only read at startup: ./rover view --restart)"
  else
    timeout 25 ssh -o BatchMode=yes "$LAPTOP_USER@$ip" \
      "DISPLAY=${disp:-:0} XAUTHORITY=$auth XDG_RUNTIME_DIR=/run/user/\$(id -u) \
       setsid nohup bash ~/rover_live.sh >/tmp/rviz.log 2>&1 </dev/null & sleep 12" >/dev/null 2>&1
    if timeout 8 ssh -o BatchMode=yes "$LAPTOP_USER@$ip" 'pgrep -x rviz2 >/dev/null' 2>/dev/null; then
      echo "  started"
    else
      echo "  ✗ rviz2 did not stay up. Its error is ON THE LAPTOP:"
      timeout 8 ssh -o BatchMode=yes "$LAPTOP_USER@$ip" 'tail -8 /tmp/rviz.log' 2>/dev/null | sed 's/^/      /'
      exit 1
    fi
  fi

  # Running is not the same as receiving. A blank RViz still shows as running.
  echo "  subscriptions (0 means it is connected to nothing):"
  for t in /robot_description /scan /map /fusion/path; do
    c=$(timeout 8 ssh -o BatchMode=yes "$LAPTOP_USER@$ip" \
        "source /opt/ros/jazzy/setup.bash; export ROS_DOMAIN_ID=0; unset ROS_DISCOVERY_SERVER; \
         timeout 6 ros2 topic info $t 2>/dev/null | grep -oP 'Subscription count: \K[0-9]+'" 2>/dev/null)
    printf "      %-42s %s\n" "$t" "${c:-0}"
  done
  ;;

# ── navto ───────────────────────────────────────────────────────────────────
# nav2 for the route, goal_exec for the exact finish (phase3/tools/navto.py).
#   ./rover navto X Y [DEG] [--exact] [--odom|--map]
navto)
  need_container
  shift
  assert_rate /odom 15 "fused odom" || die "no pose — ./rover fused first"
  assert_rate /scan 8 "laser scan"  || die "no /scan — ./rover lidar first"
  mode=$(timeout 5 curl -s http://192.168.1.16:8091/mode 2>/dev/null)
  case "$mode" in *'"manual": true'*) die "teleop is in MANUAL. Tap AUTO." ;; esac
  if ! docker exec "$NAME" pgrep -f '[g]oal_exec_node.py' >/dev/null 2>&1; then
    dexec "python3 $SRC3/nodes/goal_exec_node.py > /tmp/goal_exec.log 2>&1"; sleep 3
  fi
  ttyflag=""; [ -t 0 ] && ttyflag="-it"
  docker exec $ttyflag "$NAME" bash -lc "$ENVSET python3 -u $SRC3/tools/navto.py $(printf '%q ' "$@")"
  ;;

# ── response ────────────────────────────────────────────────────────────────
# How this rover really answers a command on this floor: pivot rate per
# command, arc following, creep speed (phase3/tools/response_test.py). Moves
# within ~30 cm. Re-run per surface; goal_exec and its simulator are set from it.
response)
  need_container
  assert_rate /odom 15 "fused odom" || die "no pose — ./rover fused first"
  mode=$(timeout 5 curl -s http://192.168.1.16:8091/mode 2>/dev/null)
  case "$mode" in *'"manual": true'*) die "teleop is in MANUAL. Tap AUTO." ;; esac
  echo "  THIS MOVES THE ROVER (turns in place, short arcs). Watch it."
  ttyflag=""; [ -t 0 ] && ttyflag="-it"
  shift
  docker exec $ttyflag "$NAME" bash -lc "$ENVSET python3 -u $SRC3/tools/response_test.py $*"
  ;;

# ── goto ────────────────────────────────────────────────────────────────────
# Exact (x, y, θ) moves (SENSOR_FUSION_PLAN.md M4): goal_exec closes on
# fusion2's pose, approaches along the goal line, learns this rover's turn
# slide as it goes, and refuses a move whose swept outline (+5 cm) or corridor
# the LiDAR says is not clear. The VLM brain can send the same goals on
# /goal_exec/goal.   ./rover goto X Y [DEG] [--odom|--map]
goto)
  need_container
  shift
  assert_rate /odom 15 "fused odom" || die "no pose — ./rover fused first"
  assert_rate /scan 8 "laser scan"  || die "no /scan — ./rover lidar first"
  mode=$(timeout 5 curl -s http://192.168.1.16:8091/mode 2>/dev/null)
  case "$mode" in *'"manual": true'*) die "teleop is in MANUAL — it streams zeros over every command. Tap AUTO." ;; esac
  if ! docker exec "$NAME" pgrep -f '[g]oal_exec_node.py' >/dev/null 2>&1; then
    echo "[goto] starting goal_exec (learned pivot: /logs/goal_exec_pivot.json)"
    dexec "python3 $SRC3/nodes/goal_exec_node.py > /tmp/goal_exec.log 2>&1"
    sleep 3
  fi
  ttyflag=""; [ -t 0 ] && ttyflag="-it"   # Ctrl-C must reach the client: it cancels the goal
  docker exec $ttyflag "$NAME" bash -lc "$ENVSET python3 $SRC3/tools/goto.py $(printf '%q ' "$@")"
  ;;

# ── record / grade ──────────────────────────────────────────────────────────
# The localization test harness (SENSOR_FUSION_PLAN.md §5, stage A). record
# drives one scenario and bags the raw sensors plus every live estimate; grade
# scores each estimate against where the LiDAR says the rover really was.
#   ./rover record straight|pivot90|pivot360|square|small|still|manual [--dist M] [--images]
#   ./rover grade [BAG ...]      (default: the newest)      ./rover grade --summary
record)
  need_container
  shift
  ttyflag=""; [ -t 0 ] && ttyflag="-it"   # Ctrl-C must reach Python: it stops the motors
  docker exec $ttyflag -e GIT_REV="$(git -C "$REPO" rev-parse --short HEAD 2>/dev/null)" \
    -e RUN_STAMP="$(date +%Y%m%d-%H%M%S)" "$NAME" \
    bash -lc "$ENVSET python3 -u $SRC/harness/run.py $(printf '%q ' "$@")"
  ;;
grade)
  need_container
  shift
  if [ $# -eq 0 ]; then
    last=$(ls -1d "$REPO"/logs/bags/*/ 2>/dev/null | tail -1)
    [ -n "$last" ] || die "no runs in logs/bags -- ./rover record first"
    set -- "$(basename "$last")"
  fi
  if [ "$1" = "--summary" ]; then
    rexec "python3 $SRC/harness/grade.py --summary /logs/bags"
  else
    args=""; for b in "$@"; do args="$args /logs/bags/$(basename "$b")"; done
    rexec "python3 $SRC/harness/grade.py $args"
  fi
  ;;

# ── status ──────────────────────────────────────────────────────────────────
values)
  need_container
  rexec "python3 $SRC/nodes/values.py"
  ;;

status)
  need_container
  echo "  layer     topic                                    rate      want"
  echo "  ------------------------------------------------------------------"
  # EVERY layer, not just the first three. A status command that stops at
  # `wheels` cannot answer "what is alive", which is the only thing it is for.
  for row in \
      "camera:$CAM_NS/infra1/image_rect_raw:15" \
      "camera:$CAM_NS/depth/image_rect_raw:10" \
      "pose:/vo/odom:10" \
      "pose:/gyro/base:50" \
      "lidar:/scan:8" \
      "wheels:/wheel_state:15" \
      "fused:/odom:15" \
      "slam:/map:0.3" \
      "map:/nvblox_node/static_occupancy_grid:1" \
      "nav:/global_costmap/costmap:0.5" \
      "nav:/local_costmap/costmap:1" \
      "vlm:/camera/color/image_raw/compressed:2"; do
    l=${row%%:*}; rest=${row#*:}; t=${rest%:*}; want=${rest##*:}
    r=$(rate_of "$t")
    if awk "BEGIN{exit !($r >= $want)}"; then v="OK"; else
      if awk "BEGIN{exit !($r > 0)}"; then v="LOW"; else v="--"; fi
    fi
    printf '  %-9s %-40s %6.1f  %5s %s\n' "$l" "$t" "$r" "$want" "$v"
  done
  # The fixed frames are latched once, not streamed, so a rate means nothing:
  # ask whether their publisher is alive instead.
  if docker exec "$NAME" pgrep -f '[r]obot_state_publisher' >/dev/null 2>&1; then v="OK"; else v="--"; fi
  printf '  %-9s %-40s %6s  %5s %s\n' frames "robot_state_publisher (description/)" "" "" "$v"

  # cuVSLAM can be publishing at 30 Hz and still be lying. It has diverged three
  # times (TODO 21) and the fallback to dead reckoning is SILENT: every rate
  # above stays green while the pose runs open-loop. So status has to look at the
  # health payload, not just the rates -- and it cannot do that with `ros2 topic
  # echo`, which TRUNCATES that JSON. health.py subscribes properly.
  echo
  rexec "python3 $SRC/nodes/health.py" || true
  ;;

logs)
  need_container
  docker exec "$NAME" bash -lc "tail -n 60 -f /tmp/${2:-camera}.log"
  ;;

stop)
  docker rm -f "$NAME" >/dev/null 2>&1 && echo "  container removed" || echo "  nothing running"
  ;;

selftest)
  python3 "$HOSTSRC/nodes/vo_node.py" --self-test
  ;;

*)
  sed -n '2,21p' "$0" | sed 's/^# \?//'
  ;;
esac
