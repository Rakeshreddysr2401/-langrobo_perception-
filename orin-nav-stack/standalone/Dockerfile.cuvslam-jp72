# cuvslam-jp72: self-contained cuVSLAM (pyCuVSLAM) for Jetson Orin Nano on JetPack 7.2.
#
# Why this differs from the stock docker/Dockerfile.realsense-cu13:
#   - librealsense is built with -DBUILD_WITH_DDS=ON so the ETHERNET D555 is
#     discoverable (the stock image is USB-only via FORCE_RSUSB_BACKEND and
#     cannot see the D555). Matches the host's proven rs_build (2.58.x + realdds).
#   - cuVSLAM comes from the prebuilt cu13/cp312/aarch64 wheel (v16.0.0) instead
#     of a from-source compile — far lighter/safer on the Orin Nano's 8 GB RAM.
#
# Host: L4T R39.2 / JetPack 7.2 / Ubuntu 24.04 / CUDA 13.2. Run with the nvidia
# runtime; the iGPU driver executes the container's CUDA 13.0 user-space fine.
FROM nvidia/cuda:13.0.0-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive

# --- Build + runtime deps (incl. GUI libs for the rerun visualizer) ---
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git curl wget ca-certificates pkg-config unzip \
        python3-pip python3-dev python3-venv \
        libusb-1.0-0-dev libssl-dev libglfw3-dev libgl1-mesa-dev libglu1-mesa-dev \
        libgtk-3-dev libxkbcommon-x11-0 libeigen3-dev \
        libx11-6 libxext6 libxrender1 libgl1 libglx-mesa0 libglib2.0-0 libsm6 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# --- librealsense with DDS (ethernet D555) + Python bindings ---
# v2.58.2 matches the host build already validated against this D555.
ARG LIBRS_VERSION=v2.58.2
RUN git clone --branch ${LIBRS_VERSION} --depth 1 \
        https://github.com/realsenseai/librealsense.git /opt/librealsense \
    && cmake -S /opt/librealsense -B /opt/librealsense/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_WITH_DDS=ON \
        -DBUILD_PYTHON_BINDINGS=ON \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_GRAPHICAL_EXAMPLES=OFF \
        -DFORCE_RSUSB_BACKEND=ON \
        -DCHECK_FOR_UPDATES=OFF \
        -DPYTHON_EXECUTABLE=$(which python3) \
    && cmake --build /opt/librealsense/build -j4 \
    && cmake --install /opt/librealsense/build \
    && ldconfig
# pyrealsense2 / pyrealdds land here
ENV PYTHONPATH=/opt/librealsense/build/Release

# --- CUDA 12 user-space libs ---
# The cu13 cuVSLAM wheel is a Thor/ARMv9-SVE build and SIGILLs on Orin; the
# cu12 wheel is the Orin/ARMv8 build (verified: imports clean on this Orin).
# The JP7.2 (CUDA-13) iGPU driver runs these CUDA-12 user-space libs fine.
RUN pip3 install --break-system-packages \
        nvidia-cuda-runtime-cu12 nvidia-cublas-cu12 nvidia-cusolver-cu12 \
        nvidia-cusparse-cu12 nvidia-nvjitlink-cu12 nvidia-nvtx-cu12
ENV CU12=/usr/local/lib/python3.12/dist-packages/nvidia
ENV LD_LIBRARY_PATH=${CU12}/cuda_runtime/lib:${CU12}/cublas/lib:${CU12}/cusolver/lib:${CU12}/cusparse/lib:${CU12}/nvjitlink/lib:${CU12}/nvtx/lib

# --- cuVSLAM prebuilt wheel (v16.0.0, CU12, cp312/abi3, aarch64 = Orin build) ---
ARG CUVSLAM_WHL=cuvslam-16.0.0+cu12-cp312-abi3-manylinux_2_39_aarch64.whl
ARG CUVSLAM_URL=https://github.com/nvidia-isaac/cuVSLAM/releases/download/v16.0.0/cuvslam-16.0.0%2Bcu12-cp312-abi3-manylinux_2_39_aarch64.whl
# pip requires the PEP-427 wheel filename, so keep the original name on disk.
RUN wget -q -O "/tmp/${CUVSLAM_WHL}" "${CUVSLAM_URL}" \
    && pip3 install --break-system-packages "/tmp/${CUVSLAM_WHL}" \
    && rm -f "/tmp/${CUVSLAM_WHL}"

# --- Example runtime deps (pinned to match the v16.0.0 examples) ---
RUN pip3 install --break-system-packages \
        numpy==2.2.4 "opencv-python~=4.11.0" pillow==12.2.0 pyyaml==6.0.2 \
        rerun-sdk==0.33.1 scipy==1.14.1

# udev rules (host owns real udev; harmless here)
RUN cp /opt/librealsense/config/99-realsense-libusb.rules /etc/udev/rules.d/ 2>/dev/null || true

# Import smoke-tests baked into the build so a broken image fails fast.
# pyrealsense2 + cuvslam are essential (hard fail); pyrealdds is a bonus (soft).
RUN python3 -c "import pyrealsense2 as rs; print('pyrealsense2 OK')" \
    && python3 -c "import cuvslam; print('cuvslam OK', getattr(cuvslam,'__version__','?'))" \
    && (python3 -c "import pyrealdds; print('pyrealdds OK')" || echo 'pyrealdds not importable (non-fatal)')

ENV NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=all
WORKDIR /cuvslam
CMD ["bash"]
