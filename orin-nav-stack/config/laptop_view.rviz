Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Tree Height: 500
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 0.5
      Plane Cell Count: 20
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: ROVER body + camera FOV wedge
      Enabled: true
      Value: true
      Topic:
        Value: /rover/model
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/TF
      Name: TF (robot + camera frames)
      Enabled: true
      Value: true
      Show Names: true
      Marker Scale: 0.5
      Frames:
        All Enabled: true
    - Class: rviz_default_plugins/Map
      Name: nvblox occupancy (live walls)
      Enabled: true
      Value: true
      Topic:
        Value: /nvblox_node/static_occupancy_grid
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color Scheme: map
      Draw Behind: true
    - Class: rviz_default_plugins/Map
      Name: global costmap (nav2 view of walls)
      Enabled: false
      Value: false
      Topic:
        Value: /global_costmap/costmap
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: costmap
    - Class: rviz_default_plugins/Path
      Name: planned path (/plan)
      Enabled: true
      Value: true
      Topic:
        Value: /plan
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Line Style: Billboards
      Line Width: 0.03
      Color: 25; 255; 25
    - Class: rviz_default_plugins/Odometry
      Name: pencil line (/odom trail)
      Enabled: true
      Value: true
      Topic:
        Value: /odom
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Keep: 300
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
        Shaft Length: 0.1
        Shaft Radius: 0.01
        Head Length: 0.05
        Head Radius: 0.02
    - Class: rviz_default_plugins/Marker
      Name: safety bumper (green=clear red=BLOCKED)
      Enabled: true
      Value: true
      Topic:
        Value: /safety/bumper
        Depth: 2
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Image
      Name: camera RAW - LEAVE OFF, it kills the map over wifi
      Enabled: false
      Value: false
      Topic:
        Value: /camera/camera0/color/image_raw
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
  Global Options:
    Fixed Frame: map
    Frame Rate: 15
    Background Color: 35; 35; 40
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 6
      Pitch: 0.9
      Yaw: 3.14
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
