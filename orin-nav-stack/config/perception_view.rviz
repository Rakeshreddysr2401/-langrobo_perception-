# Perception-only laptop view — every panel here is LIVE with just 'up' + 'fuse'.
#
# Deliberately NOT laptop_view.rviz: that one carries nav2/safety panels (/plan,
# /global_costmap, /safety/bumper) which error out when those layers are off, and a
# screen full of red errors is useless when you are learning to read the picture.
# Use laptop_view.rviz once nav2 + vision are running; use this one for mapping runs.
#
# Choices worth knowing (2026-08-10):
#   Fixed Frame = odom, not map. The nvblox grid is PUBLISHED in odom, and odom never
#     jumps. In map, every cuVSLAM loop closure lurches the whole scene sideways, which
#     looks exactly like a tracking failure to an untrained eye.
#   TWO odometry trails. /odom is raw cuVSLAM; /odometry/filtered is the EKF's fused
#     pose that actually owns the odom->base_link TF. They should overlap; where they
#     separate is the fusion earning its keep (or cuVSLAM losing tracking).
#   NO camera image. Colour runs at 23.5 Hz and pulling that over wifi competes with
#     the map stream — the documented way this laptop's map channel gets starved.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Tree Height: 500
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (0.5 m cells)
      Cell Size: 0.5
      Plane Cell Count: 20
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: ROVER body + camera FOV wedge
      Enabled: true
      Value: true
      Topic:
        Value: /rover/model
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/TF
      Name: TF (map / odom / base_link / camera)
      Enabled: true
      Value: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.4
      Frames:
        All Enabled: true
    - Class: rviz_default_plugins/Map
      Name: nvblox walls (live, builds as you drive)
      Enabled: true
      Value: true
      Topic:
        Value: /nvblox_node/static_occupancy_grid
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color Scheme: map
      Draw Behind: true
    - Class: rviz_default_plugins/Odometry
      Name: TRAIL cyan = EKF fused (the pose in charge)
      Enabled: true
      Value: true
      Topic:
        Value: /odometry/filtered
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Keep: 300
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Covariance:
        Value: false
      Shape:
        Value: Arrow
        Color: 40; 220; 230
        Alpha: 1
        Shaft Length: 0.12
        Shaft Radius: 0.012
        Head Length: 0.06
        Head Radius: 0.025
    - Class: rviz_default_plugins/Odometry
      Name: TRAIL amber = raw cuVSLAM (unfused)
      Enabled: true
      Value: true
      Topic:
        Value: /odom
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Keep: 300
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Covariance:
        Value: false
      Shape:
        Value: Arrow
        Color: 240; 160; 40
        Alpha: 0.85
        Shaft Length: 0.09
        Shaft Radius: 0.009
        Head Length: 0.05
        Head Radius: 0.019
  Global Options:
    Fixed Frame: odom
    Frame Rate: 15
    Background Color: 35; 35; 40
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 6
      Pitch: 0.9
      Yaw: 3.14
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
