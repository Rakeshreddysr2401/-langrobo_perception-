
<!--
  This Behavior Tree replans the global path periodically at 1 Hz and it also has
  recovery actions specific to planning / control as well as general system issues.
  This will be continuous if a kinematically valid planner is selected.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <ControllerSelector selected_controller="{selected_controller}" default_controller="FollowPath" topic_name="controller_selector"/>
        <PlannerSelector selected_planner="{selected_planner}" default_planner="GridBased" topic_name="planner_selector"/>
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="{selected_planner}" error_code_id="{compute_path_error_code}"/>
            <Sequence>
              <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
              <!-- no ClearGlobalCostmap here (2026-09-27): three nav2 segfaults were
                   each seconds after recovery cleared the global costmap (on
                   every failed plan, up to 2x a second) and started a Spin.
                   The global costmap needs no clearing: its LiDAR layer
                   raytraces stale marks away and nvblox's is re-read live. -->
            </Sequence>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="{selected_controller}" error_code_id="{follow_path_error_code}"/>
          <Sequence>
            <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
            <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>
      <Sequence>
        <Fallback>
          <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
          <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
        </Fallback>
        <ReactiveFallback name="RecoveryFallback">
          <GoalUpdated/>
          <RoundRobin name="RecoveryActions">
            <!-- NO SPIN (2026-10-03). It came back on 2026-09-11 (comment
                 below) because a turn shows the forward-only camera new ground.
                 reach (2026-09-26, after it) now owns that: every goal goes
                 through reach, whose "look" turns through goal_exec, checked
                 against the rover's outline AND its learned pivot slide
                 (6-16 cm per turn on this skid-steer). Nav2's Spin checks
                 neither: in a 45 cm gap it spun at 1.0 rad/s with 1 cm of
                 clearance and hit the obstacle beside it (owner saw it). -->
            <Sequence name="ClearingActions">
              <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
              <!-- local only: see the ClearGlobalCostmap note above -->
            </Sequence>
            <!-- SPIN IS BACK, and it is the FIRST thing tried after clearing.
                 TODO 40. It was removed on the grounds that this rover cannot
                 turn in place; TODO 14 fixed that and measured 65 deg/s on the
                 floor, so the grounds expired. Leaving it out cost more than it
                 saved, for a reason specific to this rover:

                 THIS ROVER IS BLIND BEHIND IT. One forward camera, 87 deg wide,
                 nothing below 10 cm, nothing rearward at all. BackUp was
                 therefore the LEAST safe recovery available and it was the ONLY
                 one. Spin is the safe one: it turns the camera onto new ground,
                 which both frees the rover and gives nvblox something to
                 observe - and an unobserved start cell is itself a common
                 reason the planner had nothing to offer.

                 Two spins, opposite directions, so a rover wedged facing a wall
                 tries one way, reverses, then tries the other. 1.57 rad is a
                 quarter turn; at the ~0.42 rad/s this chassis actually achieves
                 that is about 4 s. behavior_server's rotational limits must
                 stay above the 0.8 rad/s breakaway or Spin commands a rotation
                 that never happens - see nav2.yaml. -->
            <BackUp backup_dist="0.30" backup_speed="0.10" error_code_id="{backup_code_id}"/>
            <Wait wait_duration="5.0"/>
          </RoundRobin>
        </ReactiveFallback>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
