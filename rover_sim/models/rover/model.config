<?xml version="1.0"?>
<model>
  <name>rover</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author><name>LangRobo</name></author>
  <description>
    Simulated LangRobo rover: diff-drive chassis matching the real ESP32/L298N
    platform, with a D555-matched sensor rig (rgbd at the infra1 viewpoint,
    color at its real extrinsic offset, imu). Topic names are internal
    (/rover_sim/*); bridge/contract_bridge.py converts them to the hardware
    contract (SIM_REAL_PARITY.md).
  </description>
</model>
