<?xml version="1.0"?>
<!--
  LangRobo sim world: a 6x5m room with an inner wall + doorway, furniture,
  and lots of colored wall/floor patches. The patches are not decoration:
  RTAB-Map tracks visual features on the (grayscale) infra1 stream, and
  featureless sim walls would kill odometry exactly like a blank real wall.
  Runs headless (gz sim -s -\-headless-rendering) — see run_sim.sh.
-->
<sdf version="1.9">
  <world name="langrobo_home">
    <physics name="step" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>
    <light type="point" name="room_light">
      <cast_shadows>false</cast_shadows>
      <pose>2 0 2.4 0 0 0</pose>
      <diffuse>0.7 0.7 0.65 1</diffuse>
      <attenuation><range>12</range><linear>0.1</linear><constant>0.4</constant></attenuation>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.55 0.5 0.45 1</ambient><diffuse>0.55 0.5 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== room shell: x in [-1, 5], y in [-2.5, 2.5], walls 2.2 high -->
    <model name="wall_north"><static>true</static><pose>2 2.55 1.1 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>6.2 0.1 2.2</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6.2 0.1 2.2</size></box></geometry>
      <material><ambient>0.85 0.82 0.75 1</ambient><diffuse>0.85 0.82 0.75 1</diffuse></material></visual></link></model>
    <model name="wall_south"><static>true</static><pose>2 -2.55 1.1 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>6.2 0.1 2.2</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6.2 0.1 2.2</size></box></geometry>
      <material><ambient>0.85 0.82 0.75 1</ambient><diffuse>0.85 0.82 0.75 1</diffuse></material></visual></link></model>
    <model name="wall_west"><static>true</static><pose>-1.05 0 1.1 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.1 5.0 2.2</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.1 5.0 2.2</size></box></geometry>
      <material><ambient>0.8 0.85 0.8 1</ambient><diffuse>0.8 0.85 0.8 1</diffuse></material></visual></link></model>
    <model name="wall_east"><static>true</static><pose>5.05 0 1.1 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.1 5.0 2.2</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.1 5.0 2.2</size></box></geometry>
      <material><ambient>0.8 0.85 0.8 1</ambient><diffuse>0.8 0.85 0.8 1</diffuse></material></visual></link></model>

    <!-- inner wall at x=2.5 with a 1m doorway (y 0.5..1.5) -->
    <model name="wall_inner_a"><static>true</static><pose>2.5 -1.0 1.1 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.1 3.0 2.2</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.1 3.0 2.2</size></box></geometry>
      <material><ambient>0.75 0.75 0.85 1</ambient><diffuse>0.75 0.75 0.85 1</diffuse></material></visual></link></model>
    <model name="wall_inner_b"><static>true</static><pose>2.5 2.0 1.1 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.1 1.0 2.2</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.1 1.0 2.2</size></box></geometry>
      <material><ambient>0.75 0.75 0.85 1</ambient><diffuse>0.75 0.75 0.85 1</diffuse></material></visual></link></model>

    <!-- ===== visual-feature patches ("posters") on walls, camera height -->
    <model name="poster_1"><static>true</static><pose>0.5 2.49 0.5 0 0 0</pose><link name="l">
      <visual name="v"><geometry><box><size>0.5 0.02 0.4</size></box></geometry>
      <material><ambient>0.9 0.2 0.2 1</ambient><diffuse>0.9 0.2 0.2 1</diffuse></material></visual></link></model>
    <model name="poster_2"><static>true</static><pose>1.4 2.49 0.35 0 0 0</pose><link name="l">
      <visual name="v"><geometry><box><size>0.3 0.02 0.5</size></box></geometry>
      <material><ambient>0.2 0.7 0.25 1</ambient><diffuse>0.2 0.7 0.25 1</diffuse></material></visual></link></model>
    <model name="poster_3"><static>true</static><pose>2.2 2.49 0.6 0 0 0</pose><link name="l">
      <visual name="v"><geometry><box><size>0.45 0.02 0.3</size></box></geometry>
      <material><ambient>0.95 0.75 0.1 1</ambient><diffuse>0.95 0.75 0.1 1</diffuse></material></visual></link></model>
    <model name="poster_4"><static>true</static><pose>0.8 -2.49 0.45 0 0 0</pose><link name="l">
      <visual name="v"><geometry><box><size>0.6 0.02 0.35</size></box></geometry>
      <material><ambient>0.15 0.35 0.85 1</ambient><diffuse>0.15 0.35 0.85 1</diffuse></material></visual></link></model>
    <model name="poster_5"><static>true</static><pose>1.9 -2.49 0.3 0 0 0</pose><link name="l">
      <visual name="v"><geometry><box><size>0.25 0.02 0.45</size></box></geometry>
      <material><ambient>0.8 0.3 0.75 1</ambient><diffuse>0.8 0.3 0.75 1</diffuse></material></visual></link></model>
    <model name="poster_6"><static>true</static><pose>3.6 -2.49 0.55 0 0 0</pose><link name="l">
      <visual name="v"><geometry><box><size>0.5 0.02 0.4</size></box></geometry>
      <material><ambient>0.1 0.75 0.75 1</ambient><diffuse>0.1 0.75 0.75 1</diffuse></material></visual></link></model>
    <model name="poster_7"><static>true</static><pose>-0.99 0.6 0.5 0 0 1.5708</pose><link name="l">
      <visual name="v"><geometry><box><size>0.4 0.02 0.5</size></box></geometry>
      <material><ambient>0.9 0.5 0.15 1</ambient><diffuse>0.9 0.5 0.15 1</diffuse></material></visual></link></model>
    <model name="poster_8"><static>true</static><pose>-0.99 -0.8 0.4 0 0 1.5708</pose><link name="l">
      <visual name="v"><geometry><box><size>0.55 0.02 0.3</size></box></geometry>
      <material><ambient>0.35 0.2 0.7 1</ambient><diffuse>0.35 0.2 0.7 1</diffuse></material></visual></link></model>
    <model name="poster_9"><static>true</static><pose>4.99 0.9 0.5 0 0 1.5708</pose><link name="l">
      <visual name="v"><geometry><box><size>0.5 0.02 0.45</size></box></geometry>
      <material><ambient>0.7 0.15 0.2 1</ambient><diffuse>0.7 0.15 0.2 1</diffuse></material></visual></link></model>
    <model name="poster_10"><static>true</static><pose>4.99 -1.2 0.35 0 0 1.5708</pose><link name="l">
      <visual name="v"><geometry><box><size>0.35 0.02 0.4</size></box></geometry>
      <material><ambient>0.2 0.55 0.3 1</ambient><diffuse>0.2 0.55 0.3 1</diffuse></material></visual></link></model>
    <model name="poster_11"><static>true</static><pose>2.44 1.0 0.45 0 0 1.5708</pose><link name="l">
      <visual name="v"><geometry><box><size>0.3 0.02 0.35</size></box></geometry>
      <material><ambient>0.85 0.85 0.2 1</ambient><diffuse>0.85 0.85 0.2 1</diffuse></material></visual></link></model>

    <!-- floor patches (features at ground level) -->
    <model name="mat_1"><static>true</static><pose>1.0 0.8 0.006 0 0 0.4</pose><link name="l">
      <visual name="v"><geometry><box><size>0.6 0.4 0.01</size></box></geometry>
      <material><ambient>0.6 0.25 0.15 1</ambient><diffuse>0.6 0.25 0.15 1</diffuse></material></visual></link></model>
    <model name="mat_2"><static>true</static><pose>2.0 -1.2 0.006 0 0 -0.3</pose><link name="l">
      <visual name="v"><geometry><box><size>0.5 0.5 0.01</size></box></geometry>
      <material><ambient>0.2 0.3 0.55 1</ambient><diffuse>0.2 0.3 0.55 1</diffuse></material></visual></link></model>
    <model name="mat_3"><static>true</static><pose>3.8 0.6 0.006 0 0 0.9</pose><link name="l">
      <visual name="v"><geometry><box><size>0.45 0.6 0.01</size></box></geometry>
      <material><ambient>0.3 0.55 0.25 1</ambient><diffuse>0.3 0.55 0.25 1</diffuse></material></visual></link></model>

    <!-- ===== furniture / obstacles -->
    <model name="table"><static>true</static><pose>1.2 -1.6 0 0 0 0.2</pose>
      <link name="l">
        <collision name="top_c"><pose>0 0 0.42 0 0 0</pose><geometry><box><size>1.0 0.6 0.04</size></box></geometry></collision>
        <visual name="top_v"><pose>0 0 0.42 0 0 0</pose><geometry><box><size>1.0 0.6 0.04</size></box></geometry>
          <material><ambient>0.5 0.33 0.2 1</ambient><diffuse>0.5 0.33 0.2 1</diffuse></material></visual>
        <collision name="leg1_c"><pose>0.45 0.25 0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry></collision>
        <visual name="leg1_v"><pose>0.45 0.25 0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry>
          <material><ambient>0.4 0.26 0.15 1</ambient><diffuse>0.4 0.26 0.15 1</diffuse></material></visual>
        <collision name="leg2_c"><pose>0.45 -0.25 0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry></collision>
        <visual name="leg2_v"><pose>0.45 -0.25 0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry>
          <material><ambient>0.4 0.26 0.15 1</ambient><diffuse>0.4 0.26 0.15 1</diffuse></material></visual>
        <collision name="leg3_c"><pose>-0.45 0.25 0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry></collision>
        <visual name="leg3_v"><pose>-0.45 0.25 0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry>
          <material><ambient>0.4 0.26 0.15 1</ambient><diffuse>0.4 0.26 0.15 1</diffuse></material></visual>
        <collision name="leg4_c"><pose>-0.45 -0.25 0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry></collision>
        <visual name="leg4_v"><pose>-0.45 -0.25 0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry>
          <material><ambient>0.4 0.26 0.15 1</ambient><diffuse>0.4 0.26 0.15 1</diffuse></material></visual>
      </link></model>

    <!-- "bottle" on the table: right size/shape for the class, and a
         graspable nav target for go-object missions -->
    <model name="bottle"><static>true</static><pose>1.2 -1.6 0.565 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><cylinder><radius>0.035</radius><length>0.25</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.035</radius><length>0.25</length></cylinder></geometry>
          <material><ambient>0.1 0.6 0.15 1</ambient><diffuse>0.1 0.6 0.15 1</diffuse></material></visual>
      </link></model>

    <model name="chair_1"><static>true</static><pose>3.9 1.6 0 0 0 -0.6</pose>
      <link name="l">
        <collision name="seat_c"><pose>0 0 0.225 0 0 0</pose><geometry><box><size>0.42 0.42 0.45</size></box></geometry></collision>
        <visual name="seat_v"><pose>0 0 0.225 0 0 0</pose><geometry><box><size>0.42 0.42 0.45</size></box></geometry>
          <material><ambient>0.55 0.15 0.15 1</ambient><diffuse>0.55 0.15 0.15 1</diffuse></material></visual>
        <collision name="back_c"><pose>-0.19 0 0.65 0 0 0</pose><geometry><box><size>0.04 0.42 0.45</size></box></geometry></collision>
        <visual name="back_v"><pose>-0.19 0 0.65 0 0 0</pose><geometry><box><size>0.04 0.42 0.45</size></box></geometry>
          <material><ambient>0.55 0.15 0.15 1</ambient><diffuse>0.55 0.15 0.15 1</diffuse></material></visual>
      </link></model>

    <model name="bin"><static>true</static><pose>-0.5 1.9 0.2 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.3 1</ambient><diffuse>0.25 0.25 0.3 1</diffuse></material></visual>
      </link></model>

    <model name="crate"><static>true</static><pose>3.3 -1.8 0.15 0 0 0.5</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.4 0.3 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.3 0.3</size></box></geometry>
          <material><ambient>0.7 0.55 0.25 1</ambient><diffuse>0.7 0.55 0.25 1</diffuse></material></visual>
      </link></model>

    <!-- the rover, parked at the origin facing +x (fresh SLAM origin) -->
    <include>
      <uri>model://rover</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
